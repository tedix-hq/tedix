{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"ignoreBinaries": [
		"tedix",
		"tsc",
		"vp",
		"wrangler",
		"sandbox-exec",
		"xdg-open",
		"codex"
	],
	"ignoreDependencies": [
		"cloudflare",
		"tailwindcss",
		"tw-animate-css",
		"@tailwindcss/typography",
		"@cloudflare/containers",
		"vite",
		"vitest"
	],
	"tags": ["-internal"],
	"workspaces": {
		".": {
			"entry": ["scripts/**/*.{ts,mjs}!"],
			"project": ["scripts/**/*.{ts,mjs}!"],
			"ignoreUnresolved": ["scripts/run-local.ts"],
			"ignoreDependencies": [
				"@cloudflare/kumo",
				"npm-check-updates",
				"cf",
				"jiti",
				"mdast-util-from-markdown"
			]
		},
		"apps/*": {
			"entry": [
				"src/{index,worker,main,server}.{ts,tsx}!",
				"src/**/*.mjs!",
				"scripts/**/*.{ts,mjs,js}!",
				"eval/**/*.{ts,js}!",
				"src/pages/**/*.{astro,mdx,ts}!",
				"src/layouts/**/*.astro!",
				"cloudflare.config.ts!"
			],
			"project": [
				"src/**/*.{ts,tsx,mjs,astro,mdx}!",
				"scripts/**/*.{ts,mjs,js}!",
				"eval/**/*.{ts,js}!"
			]
		},
		"apps/api": {
			"entry": [
				"src/worker-app.ts!",
				"src/workflows/*.ts!",
				"scripts/**/*.{ts,mjs,js}!",
				"eval/**/*.{ts,js}!"
			],
			"project": ["src/**/*.ts!", "scripts/**/*.{ts,mjs,js}!", "eval/**/*.ts!"],
			"ignoreFiles": ["src/rpc/public-rest-operations.ts"],
			"ignoreUnresolved": ["src/index.ts"]
		},
		"apps/cms-runtime": {
			"entry": [
				"src/emdash-virtual-stubs.ts!",
				"scripts/**/*.{ts,mjs,js}!",
				"src/index.ts!"
			],
			"project": ["src/**/*.{ts,tsx}!", "scripts/**/*.{ts,mjs,js}!"]
		},
		"apps/mcp-ui": {
			"entry": [
				"src/{index,worker,main,server}.{ts,tsx}!",
				"src/pages/**/*.astro!",
				"src/layouts/**/*.astro!",
				"scripts/**/*.{ts,mjs,js}!"
			],
			"project": ["src/**/*.{ts,tsx,astro}!", "scripts/**/*.{ts,mjs,js}!"],
			"ignoreDependencies": ["recharts"]
		},
		"apps/os": {
			"project": ["src/**/*.{ts,tsx}!"],
			"ignoreDependencies": ["@tedix/design-tokens", "tailwindcss"],
			"entry": [
				"src/worker.ts!",
				"src/components/kumo/popover.test.browser.tsx"
			],
			"vitest": {
				"config": ["vitest*.config.ts"]
			},
			"ignoreUnresolved": [
				"/src/router.tsx",
				"/node_modules/.vite/deps/react.js",
				"/node_modules/.vite/deps/react-dom_client.js",
				"/src/components/kumo/dialog.tsx",
				"/src/components/kumo/toast.tsx"
			]
		},
		"apps/tedi-runtime": {
			"entry": [
				"src/{index,worker,main,server}.{ts,tsx}!",
				"scripts/**/*.{ts,mjs,js}!",
				"eval/**/*.{ts,js}!"
			],
			"project": [
				"src/**/*.{ts,tsx}!",
				"scripts/**/*.{ts,mjs,js}!",
				"eval/**/*.{ts,js}!"
			],
			"ignoreDependencies": ["@chat-adapter/telegram"]
		},
		"packages/*": {
			"entry": [
				"src/index.{ts,tsx}!",
				"scripts/**/*.{ts,mjs,js}!",
				"conformance/**/*.{ts,mjs,js}!"
			],
			"project": [
				"src/**/*.{ts,tsx}!",
				"scripts/**/*.{ts,mjs,js}!",
				"conformance/**/*.{ts,mjs,js}!"
			]
		},
		"packages/api-contract": {
			"entry": ["src/contracts/*.ts!"],
			"project": ["src/**/*.ts!"]
		},
		"packages/installation-manifest": {
			"entry": ["src/*-cli.ts!"],
			"project": ["src/**/*.ts!"]
		},
		"packages/cli": {
			"entry": [
				"src/index.{ts,tsx}!",
				"scripts/**/*.{ts,mjs,js}!",
				"conformance/**/*.{ts,mjs,js}!"
			],
			"project": [
				"src/**/*.{ts,tsx}!",
				"scripts/**/*.{ts,mjs,js}!",
				"conformance/**/*.{ts,mjs,js}!"
			],
			"ignoreBinaries": ["opencode"]
		},
		"apps/landing": {
			"ignoreDependencies": ["@tedix/design-tokens"],
			"entry": [
				"src/{index,worker,main,server}.{ts,tsx}!",
				"src/**/*.mjs!",
				"scripts/**/*.{ts,mjs,js}!",
				"eval/**/*.{ts,js}!",
				"src/pages/**/*.{astro,mdx,ts}!",
				"src/layouts/**/*.astro!",
				"cloudflare.config.ts!"
			],
			"project": [
				"src/**/*.{ts,tsx,mjs,astro,mdx}!",
				"scripts/**/*.{ts,mjs,js}!",
				"eval/**/*.{ts,js}!"
			]
		},
		"apps/cms": {
			"ignore": ["templates/**"],
			"entry": [
				"src/{index,worker,main,server}.{ts,tsx}!",
				"src/**/*.mjs!",
				"scripts/**/*.{ts,mjs,js}!",
				"eval/**/*.{ts,js}!",
				"src/pages/**/*.{astro,mdx,ts}!",
				"src/layouts/**/*.astro!",
				"cloudflare.config.ts!",
				"astro-render.config.mjs!",
				"tests-render/*.ts!"
			],
			"project": [
				"src/**/*.{ts,tsx,mjs,astro,mdx}!",
				"scripts/**/*.{ts,mjs,js}!",
				"eval/**/*.{ts,js}!"
			],
			"ignoreDependencies": [
				"@orpc/client",
				"@emdash-cms/plugin-forms",
				"@emdash-cms/admin",
				"kysely"
			]
		},
		"apps/tedi": {
			"entry": [
				"src/{index,worker,main,server}.{ts,tsx}!",
				"src/**/*.mjs!",
				"scripts/**/*.{ts,mjs,js}!",
				"eval/**/*.{ts,js}!",
				"src/pages/**/*.{astro,mdx,ts}!",
				"src/layouts/**/*.astro!",
				"cloudflare.config.ts!"
			],
			"project": [
				"src/**/*.{ts,tsx,mjs,astro,mdx}!",
				"scripts/**/*.{ts,mjs,js}!",
				"eval/**/*.{ts,js}!"
			],
			"vitest": {
				"config": ["vitest*.config.ts"]
			}
		},
		"packages/webmcp-core": {
			"entry": ["src/index.ts!", "src/spec-conformance.ts!"],
			"project": ["src/**/*.ts!"]
		},
		"apps/mcp": {
			"entry": [
				"src/{index,worker,main,server}.{ts,tsx}!",
				"src/env.ts!",
				"src/**/*.mjs!",
				"scripts/**/*.{ts,mjs,js}!",
				"eval/**/*.{ts,js}!",
				"src/pages/**/*.{astro,mdx,ts}!",
				"src/layouts/**/*.astro!",
				"cloudflare.config.ts!"
			],
			"project": [
				"src/**/*.{ts,tsx,mjs,astro,mdx}!",
				"scripts/**/*.{ts,mjs,js}!",
				"eval/**/*.{ts,js}!"
			]
		}
	},
	"ignoreExportsUsedInFile": true,
	"ignoreUnresolved": ["cloudflare:workers"]
}
