---
/**
 * App Catalog Detail Page
 * Displays full details for a single app from the App Catalog
 * URL: /apps/[slug] (SEO-friendly URLs)
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCatalogClient } from "../../lib/api";
import ToolsTable from "../../components/catalog/ToolsTable.tsx";
import type { CatalogAppDetail, CatalogAppListItem } from "@tedix/api-contract/schemas/catalog";
import { Badge, badgeVariants } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import { Card } from "@/components/ui/card";
import { Empty } from "@/components/ui/empty";
import { Input } from "@/components/ui/input";
import { Progress } from "@/components/ui/progress";
import { CATEGORY_LABELS, CATEGORY_COLORS, CATEGORY_GRADIENTS, DEFAULT_GRADIENT, DEVELOPER_TYPE_LABELS, CONNECTOR_TYPE_LABELS, CONNECTOR_TYPE_LABELS_FRIENDLY, HEALTH_STATUS_CONFIG, HEALTH_STATUS_LABELS_FRIENDLY, REGION_LABELS, AUTH_TYPE_LABELS, CAPABILITY_LABELS } from "../../lib/catalog-constants";

const { slug } = Astro.params;

if (!slug) {
	return new Response("App slug required", { status: 400 });
}

import { env } from 'cloudflare:workers';

// Fetch app details from the API using RPC client
let app: CatalogAppDetail | null = null;
let error: string | null = null;
let notFound = false;
let relatedApps: CatalogAppListItem[] = [];

// /apps/* carries ~96% of this property's indexed pages and ~83% of its organic
// clicks, so cold TTFB here is the SEO-critical number. Two API calls run on the
// render path and the second one CANNOT be parallelised — it needs the category
// from the first. So bound it instead: related apps are decorative, and a slow
// catalog query must never be the reason a ranking page is slow to crawl.
const RELATED_APPS_BUDGET_MS = 500;

const spans: string[] = [];
async function timed<T>(name: string, fn: () => Promise<T>): Promise<T> {
	const started = Date.now();
	try {
		return await fn();
	} finally {
		spans.push(`${name};dur=${Date.now() - started}`);
	}
}

try {
	const client = getCatalogClient(env);
	app = await timed("app_get", () => client.catalog.getBySlug({ slug }));
	if (!app) {
		notFound = true;
	} else if (app.category) {
		// Fetch related apps (same category). Non-critical: on timeout or error
		// the page renders without the related rail rather than making the
		// visitor — or Googlebot — wait for it.
		const currentApp = app;
		try {
			const related = await timed("app_related", () =>
				Promise.race([
					client.catalog.list({ category: currentApp.category!, limit: 6, offset: 0 }),
					new Promise<null>((resolve) =>
						setTimeout(() => resolve(null), RELATED_APPS_BUDGET_MS),
					),
				]),
			);
			if (related) {
				relatedApps = related.apps
					.filter((a) => a.id !== currentApp.id)
					.slice(0, 4);
			} else {
				spans.push("app_related_timeout;dur=1");
			}
		} catch { /* non-critical */ }
	}
} catch (e) {
	console.error("[Apps] Failed to fetch app from API:", e);
	error = "Failed to load app details. Please try again later.";
}

// Surface the render-path breakdown so a regression on the highest-traffic
// surface is attributable without a deploy.
if (spans.length > 0) {
	Astro.response.headers.append("Server-Timing", spans.join(", "));
}

if (!app && !notFound && !error) {
	notFound = true;
}

// A numbered catalog slug ("dropbox-2") that took over the vendor's plain name
// after a retired entry released it keeps its indexed URL by redirecting.
const unsuffixedSlug = /^(.+)-\d+$/.exec(slug)?.[1];
if (notFound && unsuffixedSlug) {
	try {
		const renamed = await getCatalogClient(env).catalog.getBySlug({
			slug: unsuffixedSlug,
		});
		if (renamed?.slug === unsuffixedSlug) {
			return Astro.redirect(`/apps/${unsuffixedSlug}/`, 301);
		}
	} catch {
		/* keep the not-found page */
	}
}

// Helper functions
function getChatGptUrl(app: CatalogAppDetail): string | null {
	// Only return a ChatGPT URL if the app actually has a ChatGPT store listing
	const chatgptListing = app.storeListings?.find(l => l.source === "chatgpt");
	if (!chatgptListing) return null;
	if (chatgptListing.storeUrl) return chatgptListing.storeUrl;
	// Fallback: construct from slug + sourceAppId
	const nameSlug = app.name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
	if (chatgptListing.sourceAppId) {
		return `https://chatgpt.com/apps/${nameSlug}/${chatgptListing.sourceAppId}`;
	}
	return null;
}

function resolveLogoUrl(logoUrl: string | null): string | null {
	if (!logoUrl) return null;
	const trimmed = logoUrl.trim();
	return /^https?:\/\//i.test(trimmed) && trimmed.includes("/app_catalog/") ? trimmed : null;
}

function cleanPublicText(value: string | null | undefined): string {
	return (value ?? "")
		.replace(/\\r\\n/g, "\n")
		.replace(/\\n/g, "\n")
		.replace(/\\r/g, "\n")
		.replace(/\\t/g, " ")
		.replace(/\r\n?/g, "\n")
		.replace(/[ \t]+\n/g, "\n")
		.replace(/\n{3,}/g, "\n\n")
		.trim();
}

function formatMcpServerVersion(version: string | null | undefined): string {
	const trimmed = version?.trim();
	if (!trimmed) return "";
	return /^v\d/i.test(trimmed) ? trimmed : `v${trimmed}`;
}

function formatDate(dateString: string | null): string {
	if (!dateString) return "Unknown";
	try {
		return new Date(dateString).toLocaleDateString("en-US", {
			year: "numeric",
			month: "long",
			day: "numeric",
		});
	} catch {
		return "Unknown";
	}
}

// Constants imported from ../../lib/catalog-constants

function formatRelativeTime(dateString: string | null): string {
	if (!dateString) return "Never";
	try {
		const date = new Date(dateString);
		const now = new Date();
		const diffMs = now.getTime() - date.getTime();
		const diffMins = Math.floor(diffMs / 60000);
		const diffHours = Math.floor(diffMs / 3600000);
		const diffDays = Math.floor(diffMs / 86400000);

		if (diffMins < 1) return "Just now";
		if (diffMins < 60) return `${diffMins}m ago`;
		if (diffHours < 24) return `${diffHours}h ago`;
		if (diffDays < 7) return `${diffDays}d ago`;
		return formatDate(dateString);
	} catch {
		return "Unknown";
	}
}

function formatLatency(ms: number | null): string {
	if (ms === null) return "N/A";
	if (ms < 1000) return `${ms}ms`;
	return `${(ms / 1000).toFixed(1)}s`;
}

function sourceLabel(source: string): string {
	const labels: Record<string, string> = {
		chatgpt: "ChatGPT app store",
		claude: "Claude connector directory",
		gemini: "Gemini",
		copilot: "Microsoft Copilot",
		official: "Official MCP registry",
		manual: "Tedix catalog",
	};
	return labels[source] ?? source.replace(/[_-]/g, " ").replace(/\b\w/g, c => c.toUpperCase());
}

function formatCapabilityList(app: CatalogAppDetail): string[] {
	return [
		app.hasWrites ? CAPABILITY_LABELS.hasWrites.label : null,
		app.hasInteractive ? CAPABILITY_LABELS.hasInteractive.label : null,
		app.hasFileSearch ? CAPABILITY_LABELS.hasFileSearch.label : null,
		app.hasDeepResearch ? CAPABILITY_LABELS.hasDeepResearch.label : null,
		app.hasSync ? CAPABILITY_LABELS.hasSync.label : null,
	].filter((item): item is string => Boolean(item));
}

function formatActionIntent(tool: NonNullable<CatalogAppDetail["tools"]>[number]): string {
	const annotations = tool.annotations;
	if (annotations?.destructiveHint) return "High-impact write action";
	if (annotations?.readOnlyHint) return "Read-only action";
	if (annotations?.idempotentHint) return "Repeatable action";
	if (annotations?.openWorldHint) return "External-world action";
	return "App action";
}

function formatFreshness(dateString: string | null): string {
	if (!dateString) return "No timestamp available";
	const relative = formatRelativeTime(dateString);
	const absolute = formatDate(dateString);
	return relative === absolute ? absolute : `${relative} (${absolute})`;
}

// Get health status config with fallback
const healthConfig = app?.healthStatus ? HEALTH_STATUS_CONFIG[app.healthStatus] || HEALTH_STATUS_CONFIG.unknown : null;
const isMcpHealthy =
	app?.healthStatus === "healthy" || app?.healthStatus === "degraded";
const isMcpAuthRequired = app?.healthStatus === "requires_auth";
const isMcpDegraded = app?.healthStatus === "degraded";
const mcpResourceTemplateCount = app?.resourceTemplates?.length ?? 0;
const mcpResourceDisplayCount =
	(app?.mcpResourceCount ?? 0) + mcpResourceTemplateCount;
const mcpCountsEmpty = Boolean(
	(app?.mcpToolCount ?? 0) === 0 &&
		(app?.mcpResourceCount ?? 0) === 0 &&
		(app?.mcpPromptCount ?? 0) === 0 &&
		mcpResourceTemplateCount === 0,
);
const hasMcpDeclaredInventory = Boolean(
	app?.connectorType === "MCP" && !isMcpHealthy && !mcpCountsEmpty,
);
const showMcpCounts = Boolean(app?.connectorType === "MCP" && (isMcpHealthy || hasMcpDeclaredInventory));
const hasHealthCheck = Boolean(app?.healthLastCheckedAt);
const storeSources = Array.from(
	new Set(app?.storeListings?.map((listing) => listing.source).filter(Boolean) ?? []),
);
const claudeListing = app?.storeListings?.find(l => l.source === "claude");

// Get gradient for logo fallback (deterministic by name when no category)
function getGradientForApp(name: string, category: string | null): string {
	const nameGradients = [
		"from-blue-500 to-indigo-600",
		"from-violet-500 to-purple-600",
		"from-emerald-400 to-teal-600",
		"from-orange-400 to-amber-600",
		"from-pink-400 to-rose-600",
		"from-cyan-400 to-blue-600",
		"from-red-400 to-pink-600",
		"from-indigo-400 to-blue-600",
		"from-rose-400 to-red-500",
		"from-amber-400 to-orange-600",
		"from-fuchsia-400 to-purple-600",
		"from-lime-400 to-green-600",
	];
	if (category && CATEGORY_GRADIENTS[category]) {
		return CATEGORY_GRADIENTS[category];
	}
	let hash = 0;
	for (let i = 0; i < name.length; i++) {
		hash = (hash * 31 + name.charCodeAt(i)) | 0;
	}
	return nameGradients[Math.abs(hash) % nameGradients.length];
}
const headerGradient = app ? getGradientForApp(app.name, app.category) : DEFAULT_GRADIENT;
const discoverability = app?.discoverability ?? null;
const discoverabilityScore = discoverability?.score ?? 0;
const discoverabilityColorClass =
	discoverabilityScore >= 85
		? "text-green-600 dark:text-green-400"
		: discoverabilityScore >= 70
			? "text-emerald-600 dark:text-emerald-400"
			: discoverabilityScore >= 50
				? "text-yellow-600 dark:text-yellow-400"
				: "text-red-600 dark:text-red-400";
const discoverabilityTrackClass =
	discoverabilityScore >= 85
		? "bg-green-500"
		: discoverabilityScore >= 70
			? "bg-emerald-500"
			: discoverabilityScore >= 50
				? "bg-yellow-500"
				: "bg-red-500";

// Handle 404 case - provide fallback values for metadata
const chatGptUrl = app ? getChatGptUrl(app) : null;
const logoUrl = app ? resolveLogoUrl(app.logoUrl) : null;
const screenshots: string[] = app?.screenshots || [];
const appDescription = cleanPublicText(app?.description);
const appSeoDescription = cleanPublicText(app?.seoDescription);
const appModelDescription = cleanPublicText(app?.modelDescription);

// Parse regions from storeListings
const regions: string[] = app?.storeListings
	? [...new Set(app.storeListings.flatMap(l => l.regions || []))]
	: [];

// SEO metadata - optimized for searches like "Kleinanzeigen chatgpt app"
// Use different title/description for 404 state
const primaryCategoryLabel = app?.category ? CATEGORY_LABELS[app.category] || app.category : null;
const categoryLabel = primaryCategoryLabel ?? "";
const pageTitle = app
	? `${app.name} — AI App | Tedix Directory`
	: notFound
		? `App Not Found | Tedix Directory`
		: `App Directory Unavailable | Tedix`;
const pageDescription = app
	? appSeoDescription
		? appSeoDescription
		: appDescription
			? `${appDescription.slice(0, 150)}${appDescription.length > 150 ? "..." : ""}`
			: `Explore ${app.name} AI app. ${categoryLabel ? `Category: ${categoryLabel}. ` : ""}${app.developer ? `Built by ${app.developer}.` : ""} View features, capabilities, and how to use this app.`
	: notFound
		? `The app "${slug}" could not be found. Browse our directory of AI apps to find what you're looking for.`
		: "The Tedix app directory is temporarily unavailable.";

// Canonical URL for SEO - NEW: /apps/ instead of /marketplace/
const canonicalUrl = new URL(`/apps/${app?.slug || slug}/`, Astro.site || "https://tedix.dev");
// A non-runnable variant hidden from browsing canonicalizes to the runnable
// same-vendor app, so search engines index one page per vendor.
const seoCanonicalUrl = app?.canonicalSlug
	? new URL(`/apps/${app.canonicalSlug}/`, Astro.site || "https://tedix.dev")
	: canonicalUrl;
const appVariants = (app?.variants ?? []).filter((variant) => variant.slug);
const variantLabel = (variant: (typeof appVariants)[number]) => {
	if (variant.installabilityState !== "installable" && variant.installabilityState !== "needs_base_app") {
		return "Listing only";
	}
	if (variant.mcpToolCount === 0) return "MCP server";
	return `${variant.mcpToolCount} ${variant.mcpToolCount === 1 ? "tool" : "tools"}`;
};
const agentDiscoveryCategory = primaryCategoryLabel ?? "AI application";
const agentDiscoveryWorkflowContext = primaryCategoryLabel
	? primaryCategoryLabel.toLowerCase()
	: "general AI app";
const agentDiscoveryCategorySignal = app?.category
	? `${app.name} is categorized as ${primaryCategoryLabel}.`
	: `${app?.name ?? "This app"} has no primary catalog category yet; Tedix treats this as a routing gap for browse and recommendation surfaces.`;
const agentDiscoveryConnector = app?.connectorType
	? CONNECTOR_TYPE_LABELS_FRIENDLY[app.connectorType] || CONNECTOR_TYPE_LABELS[app.connectorType] || app.connectorType
	: "AI app";
const agentDiscoveryCapabilities = app ? [
	app.hasWrites ? "write or update records when authorized" : null,
	app.hasInteractive ? "support interactive workflows" : null,
	app.hasFileSearch ? "search files or knowledge sources" : null,
	app.hasDeepResearch ? "support research-style tasks" : null,
	app.hasSync ? "sync data between systems" : null,
].filter((item): item is string => Boolean(item)) : [];
const agentDiscoverySignals = app ? [
	agentDiscoveryCategorySignal,
	app.developer ? `Developer: ${app.developer}.` : null,
	`Connector type: ${agentDiscoveryConnector}.`,
	app.healthStatus ? `Current connector status: ${HEALTH_STATUS_LABELS_FRIENDLY[app.healthStatus] || app.healthStatus}.` : null,
	storeSources.length > 0 ? `Observed distribution channels: ${storeSources.join(", ")}.` : null,
	regions.length > 0 ? `Available regions: ${regions.map(region => REGION_LABELS[region] || region).join(", ")}.` : null,
	agentDiscoveryCapabilities.length > 0 ? `Declared capabilities: ${agentDiscoveryCapabilities.join(", ")}.` : null,
].filter((item): item is string => Boolean(item)) : [];
const agentDiscoveryUseCases = app ? [
	`Use this page to understand whether ${app.name} is relevant for ${agentDiscoveryWorkflowContext} workflows in AI assistants.`,
	app.connectorType === "MCP"
		? `For MCP discovery, this listing helps crawlers connect ${app.name} to tool, resource, prompt, and server-health signals instead of treating it as a generic directory entry.`
		: `For AI app discovery, this listing gives crawlers a stable canonical page with category, publisher, availability, and capability context.`,
	`The canonical Tedix directory URL is ${canonicalUrl.href}.`,
] : [];
const capabilityLabels = app ? formatCapabilityList(app) : [];
const authSummary = app
	? app.authTypes && app.authTypes.length > 0
		? app.authTypes.map(t => AUTH_TYPE_LABELS[t] || t).join(", ")
		: app.storeListings?.some((listing) => listing.authRequired)
			? "Authentication required by at least one source listing"
			: "Open Access"
	: "";
const sourceProfile = app ? [
	app.toolSource ? `${sourceLabel(app.toolSource)} tool source` : null,
	storeSources.length > 0 ? `Store sources: ${storeSources.map(sourceLabel).join(", ")}` : null,
	app.distributionChannel ? `Distribution: ${app.distributionChannel.replace(/_/g, " ").toLowerCase().replace(/\b\w/g, c => c.toUpperCase())}` : null,
	app.installability.installable
		? "Tenant install: prepared"
		: `Tenant install: ${app.installability.reason}`,
].filter((item): item is string => Boolean(item)) : [];
const sourceListingsProfile = app?.storeListings
	?.slice(0, 6)
	.map((listing) => ({
		label: sourceLabel(listing.source),
		url: listing.storeUrl,
		auth: listing.authRequired ? "Auth required" : "Auth not flagged",
		reviewStatus: listing.reviewStatus,
		regions: listing.regions?.map(region => REGION_LABELS[region] || region).join(", "),
		lastSynced: listing.lastSyncedAt,
	})) ?? [];
const verificationProfile = app ? [
	{ label: "Catalog synced", value: formatFreshness(app.lastSyncedAt) },
	app.healthLastCheckedAt ? { label: "Connector checked", value: formatFreshness(app.healthLastCheckedAt) } : null,
	app.mcpLastScannedAt ? { label: "MCP scanned", value: formatFreshness(app.mcpLastScannedAt) } : null,
	app.updatedAt ? { label: "Directory updated", value: formatFreshness(app.updatedAt) } : null,
].filter((item): item is { label: string; value: string } => Boolean(item)) : [];
const actionProfile = app?.tools
	?.filter((tool) => !tool.removedAt)
	.slice(0, 8)
	.map((tool) => ({
		name: tool.title || tool.toolName,
		technicalName: tool.toolName,
		description: cleanPublicText(tool.description),
		intent: formatActionIntent(tool),
		lastSeenAt: tool.lastSeenAt,
		lastTestedAt: tool.lastTestedAt,
		successRate: tool.testSuccessRate,
	})) ?? [];
const hiddenActionCount = Math.max(0, (app?.tools?.filter((tool) => !tool.removedAt).length ?? 0) - actionProfile.length);
const relatedProfile = relatedApps.map((related) => ({
	name: related.name,
	url: new URL(`/apps/${related.slug || related.id}/`, Astro.site || "https://tedix.dev").toString(),
	category: related.category ? CATEGORY_LABELS[related.category] || related.category : null,
	description: cleanPublicText(related.description),
}));
const publisherSignalCards = app
	? [
			{
				label: "Visitor takeaway",
				value: discoverability ? `${discoverabilityScore}/100` : "Pending",
				body: discoverability
					? `${discoverability.label} AI-discovery coverage across description, prompts, keywords, visuals, tool metadata, health, and freshness.`
					: "Tedix is still computing the public discovery profile for this app.",
			},
			{
				label: "Routing category",
				value: app.category ? CATEGORY_LABELS[app.category] || app.category : "Needs category",
				body: app.category
					? "This app has a primary category, so visitors can browse and compare it in the right directory context."
					: "This listing is missing a primary category, which weakens browse placement and AI recommendation routing.",
			},
			{
				label: "Connector evidence",
				value:
					app.connectorType === "MCP"
						? isMcpHealthy
							? "Reachable"
							: hasMcpDeclaredInventory
								? "Auth required"
								: "Not verified"
						: "Catalog listing",
				body:
					app.connectorType === "MCP"
						? isMcpHealthy
							? "Tedix can reach this MCP endpoint and can show live capability evidence when tools are discovered."
							: hasMcpDeclaredInventory
								? "Tedix found publisher-declared MCP capabilities, but live tool calls still require OAuth."
								: "Tedix cannot currently verify live MCP tools from the endpoint, so visitors should treat capabilities as unconfirmed."
						: "This listing is useful for discovery, but it is not a live MCP endpoint verification.",
			},
			{
				label: "Directory freshness",
				value: app.lastSyncedAt ? formatRelativeTime(app.lastSyncedAt) : "Unknown",
				body: app.lastSyncedAt
					? `Catalog metadata was refreshed ${formatFreshness(app.lastSyncedAt)}.`
					: "No catalog refresh timestamp is available yet.",
			},
		]
	: [];

// OG Image - use logo or default
const ogImage = logoUrl || new URL("/og-image.svg", Astro.site || "https://tedix.dev").href;

// CDN edge caching. Freshness is unchanged at 5 minutes — what widens is the
// stale-while-revalidate window, from 10 minutes to 24 hours.
//
// Why: a cache MISS here costs 2-4s, because it is usually the first request
// into a fresh apps/api isolate and pays that Worker's module init (15.8 MB
// bundle). Googlebot crawling 2,657 app URLs hits a miss on nearly every one.
// Inside the SWR window the edge answers instantly from the stale copy and
// revalidates in the background, so a page crawled at least once a day
// effectively never blocks on the cold path.
//
// This does not make content staler in practice: s-maxage still expires after
// 5 minutes and the background revalidate still runs on the next request. SWR
// only governs whether the edge may answer while that happens instead of
// blocking. Cloudflare honours stale-while-revalidate on all plans.
//
// 404s keep the short window so a newly listed app appears quickly.
Astro.response.headers.set(
	"Cache-Control",
	notFound
		? "public, s-maxage=60, stale-while-revalidate=120"
		: "public, s-maxage=300, stale-while-revalidate=86400"
);
if (notFound) {
	Astro.response.status = 404;
} else if (error && !app) {
	Astro.response.status = 503;
}

const organizationId = "https://tedix.dev/#organization";
const webSiteId = "https://tedix.dev/#website";
const webPageId = `${canonicalUrl.href}#webpage`;
const softwareApplicationId = `${canonicalUrl.href}#softwareapplication`;
const sameAsUrls = app?.storeListings
	?.map((listing) => listing.storeUrl)
	.filter((url): url is string => Boolean(url))
	.slice(0, 12) ?? [];
const toolActionStructuredData = actionProfile.map((tool, index) => ({
	"@type": "Action",
	"@id": `${canonicalUrl.href}#action-${index + 1}`,
	name: tool.name,
	description: tool.description || `${tool.intent} exposed by ${app?.name}.`,
	instrument: {
		"@type": "SoftwareSourceCode",
		name: tool.technicalName,
	},
	actionStatus: "https://schema.org/PotentialActionStatus",
	additionalProperty: [
		{ "@type": "PropertyValue", name: "Action intent", value: tool.intent },
		tool.lastSeenAt ? { "@type": "PropertyValue", name: "Last seen", value: tool.lastSeenAt } : null,
		tool.lastTestedAt ? { "@type": "PropertyValue", name: "Last tested", value: tool.lastTestedAt } : null,
		tool.successRate !== null ? { "@type": "PropertyValue", name: "Test success rate", value: String(tool.successRate) } : null,
	].filter(Boolean),
}));
const sourceStructuredData = sourceListingsProfile.map((listing, index) => ({
	"@type": "WebPage",
	"@id": `${canonicalUrl.href}#source-${index + 1}`,
	name: `${app?.name} on ${listing.label}`,
	url: listing.url || canonicalUrl.href,
	isPartOf: { "@id": webSiteId },
	about: { "@id": softwareApplicationId },
	additionalProperty: [
		{ "@type": "PropertyValue", name: "Source", value: listing.label },
		{ "@type": "PropertyValue", name: "Auth", value: listing.auth },
		listing.reviewStatus ? { "@type": "PropertyValue", name: "Review status", value: listing.reviewStatus } : null,
		listing.regions ? { "@type": "PropertyValue", name: "Regions", value: listing.regions } : null,
		listing.lastSynced ? { "@type": "PropertyValue", name: "Last synced", value: listing.lastSynced } : null,
	].filter(Boolean),
}));
const relatedStructuredData = relatedProfile.length > 0 ? {
	"@type": "ItemList",
	"@id": `${canonicalUrl.href}#related-apps`,
	name: `Apps related to ${app?.name}`,
	itemListElement: relatedProfile.map((related, index) => ({
		"@type": "ListItem",
		position: index + 1,
		url: related.url,
		name: related.name,
		description: related.description || undefined,
	})),
} : null;

// JSON-LD Structured Data for SoftwareApplication (only for valid apps)
const structuredData = app ? {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "SoftwareApplication",
			"@id": softwareApplicationId,
			name: app.name,
			description: appDescription || pageDescription,
			applicationCategory: categoryLabel || "AI Application",
			operatingSystem: "Any",
			url: canonicalUrl.href,
			mainEntityOfPage: { "@id": webPageId },
			isPartOf: { "@id": "https://tedix.dev/apps/#itemlist" },
			provider: { "@id": organizationId },
			publisher: { "@id": organizationId },
			author: app.developer ? {
				"@type": "Organization",
				name: app.developer,
			} : undefined,
			softwareVersion: app.mcpServerVersion || undefined,
			dateModified: app.updatedAt || app.lastSyncedAt,
			datePublished: app.sourceCreatedAt || app.createdAt || undefined,
			image: logoUrl || undefined,
			sameAs: sameAsUrls.length > 0 ? sameAsUrls : undefined,
			featureList: capabilityLabels.length > 0 ? capabilityLabels : undefined,
			applicationSubCategory: app.connectorType || undefined,
			softwareRequirements: authSummary,
			potentialAction: toolActionStructuredData.length > 0 ? toolActionStructuredData.map((action) => ({ "@id": action["@id"] })) : undefined,
			subjectOf: [
				sourceStructuredData.length > 0 ? { "@id": `${canonicalUrl.href}#sources` } : null,
				relatedStructuredData ? { "@id": `${canonicalUrl.href}#related-apps` } : null,
			].filter(Boolean),
			offers: {
				"@type": "Offer",
				price: "0",
				priceCurrency: "USD",
				availability: "https://schema.org/InStock",
			},
			availableLanguage: regions.length > 0 ? regions.map(r => ({ "@type": "Language", name: r })) : undefined,
			keywords: [
				app.name,
				categoryLabel,
				agentDiscoveryConnector,
				...storeSources,
			].filter(Boolean).join(", "),
			additionalProperty: [
				{ "@type": "PropertyValue", name: "Authentication", value: authSummary },
				app.toolSource ? { "@type": "PropertyValue", name: "Tool source", value: sourceLabel(app.toolSource) } : null,
				app.healthStatus ? { "@type": "PropertyValue", name: "Connector health", value: HEALTH_STATUS_LABELS_FRIENDLY[app.healthStatus] || app.healthStatus } : null,
				app.lastSyncedAt ? { "@type": "PropertyValue", name: "Last catalog sync", value: app.lastSyncedAt } : null,
				app.healthLastCheckedAt ? { "@type": "PropertyValue", name: "Last health check", value: app.healthLastCheckedAt } : null,
				app.mcpLastScannedAt ? { "@type": "PropertyValue", name: "Last MCP scan", value: app.mcpLastScannedAt } : null,
				{ "@type": "PropertyValue", name: "MCP tool count", value: String(app.mcpToolCount ?? app.tools?.length ?? 0) },
			].filter(Boolean),
		},
		{
			"@type": "WebPage",
			"@id": webPageId,
			url: canonicalUrl.href,
			name: pageTitle,
			description: pageDescription,
			isPartOf: { "@id": webSiteId },
			publisher: { "@id": organizationId },
			about: { "@id": softwareApplicationId },
			mainEntity: { "@id": softwareApplicationId },
			breadcrumb: { "@id": `${canonicalUrl.href}#breadcrumbs` },
			mentions: relatedProfile.map((related) => ({
				"@type": "SoftwareApplication",
				name: related.name,
				url: related.url,
				applicationCategory: related.category || undefined,
			})),
		},
		sourceStructuredData.length > 0 ? {
			"@type": "ItemList",
			"@id": `${canonicalUrl.href}#sources`,
			name: `${app.name} listing sources`,
			itemListElement: sourceStructuredData.map((source, index) => ({
				"@type": "ListItem",
				position: index + 1,
				item: { "@id": source["@id"] },
			})),
		} : null,
		...sourceStructuredData,
		toolActionStructuredData.length > 0 ? {
			"@type": "ItemList",
			"@id": `${canonicalUrl.href}#actions`,
			name: `${app.name} MCP tools and actions`,
			numberOfItems: app.tools?.filter((tool) => !tool.removedAt).length ?? toolActionStructuredData.length,
			itemListElement: toolActionStructuredData.map((action, index) => ({
				"@type": "ListItem",
				position: index + 1,
				item: { "@id": action["@id"] },
			})),
		} : null,
		...toolActionStructuredData,
		relatedStructuredData,
		{
			"@type": "BreadcrumbList",
			"@id": `${canonicalUrl.href}#breadcrumbs`,
			itemListElement: [
				{
					"@type": "ListItem",
					position: 1,
					name: "Tedix",
					item: "https://tedix.dev/",
				},
				{
					"@type": "ListItem",
					position: 2,
					name: "AI App Directory",
					item: "https://tedix.dev/apps/",
				},
				{
					"@type": "ListItem",
					position: 3,
					name: app.name,
					item: canonicalUrl.href,
				},
			],
		},
	].filter(Boolean),
} : null;

// Clean up undefined values from structured data
const cleanStructuredData = structuredData ? JSON.parse(JSON.stringify(structuredData)) : null;
---

<BaseLayout
	title={pageTitle}
	description={pageDescription}
	image={ogImage}
	consentBannerVariant="compact"
	includeSoftwareApplicationSchema={false}
	includeWebPageSchema={false}
	canonicalPath={seoCanonicalUrl.pathname}
>
	{notFound && <meta name="robots" content="noindex, follow" slot="head" />}

	<!-- JSON-LD Structured Data (only for valid apps) -->
	{cleanStructuredData && (
		<script type="application/ld+json" set:html={JSON.stringify(cleanStructuredData)} slot="head" />
	)}
	<div class="container mx-auto px-4 pt-24 pb-12 md:pt-28 md:pb-16">
		<!-- Back Navigation -->
		<nav class="mb-6">
			<a
				href="/apps/"
				class="inline-flex items-center gap-2 text-muted-foreground hover:text-foreground transition-colors group text-sm"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					class="h-4 w-4 transition-transform group-hover:-translate-x-1"
					fill="none"
					viewBox="0 0 24 24"
					stroke="currentColor"
					stroke-width="2"
				>
					<path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
				</svg>
				<span>Back to Apps</span>
			</a>
		</nav>

		<!-- Error State -->
		{error && (
			<Empty
				className="py-12"
				title="App details unavailable"
				description={error}
			/>
		)}

		<!-- 404 Not Found State -->
		{notFound && !error && (
			<div class="max-w-2xl mx-auto text-center py-16">
				<Empty
					title="App not found"
					description={`We couldn't find an app called “${slug}”. It may have been removed, renamed, or never existed.`}
				/>

				<!-- Search Box -->
				<div class="max-w-md mx-auto mb-8">
					<form action="/apps" method="get" class="flex gap-2">
						<div class="relative flex-1">
							<svg
								xmlns="http://www.w3.org/2000/svg"
								class="absolute left-3 top-1/2 -translate-y-1/2 h-5 w-5 text-muted-foreground"
								fill="none"
								viewBox="0 0 24 24"
								stroke="currentColor"
								stroke-width="2"
							>
								<circle cx="11" cy="11" r="8" />
								<path d="m21 21-4.3-4.3" />
							</svg>
							<Input
								type="search"
								name="q"
								aria-label="Search apps"
								placeholder="Search for apps..."
								className="h-12 pl-10"
							/>
						</div>
						<button
							type="submit"
							class={buttonVariants({ size: "lg" })}
						>
							Search
						</button>
					</form>
				</div>

				<!-- Actions -->
				<div class="flex flex-wrap justify-center gap-4">
					<a
						href="/apps/"
						class={buttonVariants({ variant: "secondary", size: "lg" })}
					>
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
						</svg>
						Browse All Apps
					</a>
					<a
						href="/apps/?category=PRODUCTIVITY"
						class={buttonVariants({ variant: "outline", size: "lg" })}
					>
						Popular: Productivity
					</a>
					<a
						href="/apps/?category=DEVELOPER_TOOLS"
						class={buttonVariants({ variant: "outline", size: "lg" })}
					>
						Developer Tools
					</a>
				</div>
			</div>
		)}

		{!error && !notFound && app && (
			<div class="max-w-5xl mx-auto">

				<!-- ============================================================ -->
				<!-- ZONE 1: App Overview (consumer-friendly)                     -->
				<!-- ============================================================ -->

				<!-- Hero Banner -->
				<div class="relative -mx-4 md:-mx-0 mb-10 overflow-hidden rounded-none md:rounded-2xl">
					<!-- Gradient background -->
					<div class={`absolute inset-0 bg-gradient-to-br ${headerGradient} opacity-15 dark:opacity-10`}></div>
					<div class="absolute inset-0 bg-gradient-to-t from-background via-background/80 to-transparent"></div>
					<header class="relative z-[1] flex flex-col md:flex-row gap-6 items-start p-6 md:p-10 pt-8 md:pt-12">
						<!-- Logo -->
						<div class={`relative flex-shrink-0 w-20 h-20 md:w-24 md:h-24 rounded-2xl flex items-center justify-center overflow-hidden shadow-xl ring-2 ring-white/10 ${logoUrl ? 'bg-card' : `bg-gradient-to-br ${headerGradient}`}`}>
							{logoUrl ? (
								<img
									src={logoUrl}
									alt={`${app.name} logo`}
									class="w-full h-full object-cover"
								/>
							) : (
								<span class="text-3xl md:text-4xl font-bold text-white drop-shadow-sm">
									{app.name.charAt(0).toUpperCase()}
								</span>
							)}
						</div>

						<!-- Title & Meta -->
						<div class="flex-1 min-w-0">
						<div class="flex flex-wrap items-center gap-2 mb-2">
							{app.category && (
								<Badge variant="outline" className={CATEGORY_COLORS[app.category] || "bg-muted text-muted-foreground border-border"}>
									{CATEGORY_LABELS[app.category] || app.category}
								</Badge>
							)}
							{!app.category && (
								<Badge variant="warning">
									Category needed
								</Badge>
							)}
							{/* Additional categories (excluding primary) */}
							{app.categories && app.categories.filter(c => c !== app.category).map((cat) => (
								<a
									href={`/apps?category=${encodeURIComponent(cat)}`}
									class={badgeVariants({
										variant: "outline",
										className: `transition-opacity hover:opacity-80 ${CATEGORY_COLORS[cat] || "bg-muted text-muted-foreground border-border"}`,
									})}
								>
									{CATEGORY_LABELS[cat] || cat}
								</a>
							))}
							{/* AI App badge */}
							<Badge variant="secondary" className="gap-1">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
									<polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
									<line x1="12" y1="22.08" x2="12" y2="12"></line>
								</svg>
								AI App
							</Badge>
							{/* Health Status Badge (friendly labels) */}
							{healthConfig && app.connectorType === "MCP" && (
								<Badge variant="outline" className={`gap-1.5 ${healthConfig.bgColor} ${healthConfig.color} ${healthConfig.borderColor}`}>
									{healthConfig.icon === "check-circle" && (
										<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
											<polyline points="22 4 12 14.01 9 11.01"></polyline>
										</svg>
									)}
									{healthConfig.icon === "alert-triangle" && (
										<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
											<line x1="12" y1="9" x2="12" y2="13"></line>
											<line x1="12" y1="17" x2="12.01" y2="17"></line>
										</svg>
									)}
									{healthConfig.icon === "x-circle" && (
										<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<circle cx="12" cy="12" r="10"></circle>
											<line x1="15" y1="9" x2="9" y2="15"></line>
											<line x1="9" y1="9" x2="15" y2="15"></line>
										</svg>
									)}
									{healthConfig.icon === "lock" && (
										<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
											<path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
										</svg>
									)}
									{(healthConfig.icon === "minus-circle" || healthConfig.icon === "help-circle") && (
										<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<circle cx="12" cy="12" r="10"></circle>
											<line x1="8" y1="12" x2="16" y2="12"></line>
										</svg>
									)}
									<span>{HEALTH_STATUS_LABELS_FRIENDLY[app.healthStatus ?? "unknown"] || healthConfig.label}</span>
									{app.healthUptimePercent !== null && (app.healthStatus === "healthy" || app.healthStatus === "degraded") && (
										<span class="opacity-75">· {app.healthUptimePercent.toFixed(0)}% uptime</span>
									)}
								</Badge>
							)}
						</div>

						<h1 class="text-3xl md:text-4xl lg:text-5xl font-bold font-display mb-3">
							{app.name}
						</h1>

						{app.developer && (
							<p class="text-lg text-muted-foreground mb-4">
								by <span class="font-medium text-foreground">{app.developer}</span>
								{app.developerType && (
									<span class="ml-2 text-sm">
										({DEVELOPER_TYPE_LABELS[app.developerType] || app.developerType})
									</span>
								)}
							</p>
						)}

						<!-- Region Badges -->
						{regions.length > 0 && (
							<div class="flex flex-wrap items-center gap-2 mb-4">
								<span class="text-sm text-muted-foreground">Available in:</span>
								{regions.map((region) => (
									<Badge variant="outline">
										{REGION_LABELS[region] || region}
									</Badge>
								))}
							</div>
						)}

						<!-- Platform Store Badges -->
						{storeSources.length > 0 && (
							<div class="flex flex-wrap items-center gap-2 mb-4">
								<span class="text-sm text-muted-foreground">Available on:</span>
								{storeSources.includes("chatgpt") && (
									<Badge variant="success" className="gap-1.5">
										<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M22.282 9.821a5.985 5.985 0 0 0-.516-4.91 6.046 6.046 0 0 0-6.51-2.9A6.065 6.065 0 0 0 4.981 4.18a5.985 5.985 0 0 0-3.998 2.9 6.046 6.046 0 0 0 .743 7.097 5.98 5.98 0 0 0 .51 4.911 6.051 6.051 0 0 0 6.515 2.9A5.985 5.985 0 0 0 13.26 24a6.056 6.056 0 0 0 5.772-4.206 5.99 5.99 0 0 0 3.997-2.9 6.056 6.056 0 0 0-.747-7.073zM13.26 22.43a4.476 4.476 0 0 1-2.876-1.04l.141-.081 4.779-2.758a.795.795 0 0 0 .392-.681v-6.737l2.02 1.168a.071.071 0 0 1 .038.052v5.583a4.504 4.504 0 0 1-4.494 4.494zM3.6 18.304a4.47 4.47 0 0 1-.535-3.014l.142.085 4.783 2.759a.771.771 0 0 0 .78 0l5.843-3.369v2.332a.08.08 0 0 1-.033.062L9.74 19.95a4.5 4.5 0 0 1-6.14-1.646zM2.34 7.896a4.485 4.485 0 0 1 2.366-1.973V11.6a.766.766 0 0 0 .388.676l5.815 3.355-2.02 1.168a.076.076 0 0 1-.071 0l-4.83-2.786A4.504 4.504 0 0 1 2.34 7.872zm16.597 3.855l-5.833-3.387L15.119 7.2a.076.076 0 0 1 .071 0l4.83 2.791a4.494 4.494 0 0 1-.676 8.105v-5.678a.79.79 0 0 0-.407-.667zm2.01-3.023l-.141-.085-4.774-2.782a.776.776 0 0 0-.785 0L9.409 9.23V6.897a.066.066 0 0 1 .028-.061l4.83-2.787a4.5 4.5 0 0 1 6.68 4.66zm-12.64 4.135l-2.02-1.164a.08.08 0 0 1-.038-.057V6.075a4.5 4.5 0 0 1 7.375-3.453l-.142.08L8.704 5.46a.795.795 0 0 0-.393.681zm1.097-2.365l2.602-1.5 2.607 1.5v2.999l-2.597 1.5-2.607-1.5z"/></svg>
										ChatGPT
									</Badge>
								)}
								{storeSources.includes("claude") && (
									<Badge variant="warning" className="gap-1.5">
										<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M4.709 15.955l4.397-2.506a.273.273 0 0 0 .023-.464L4.538 9.877a.793.793 0 0 1-.332-.651V4.994a.793.793 0 0 1 1.16-.702l4.59 2.446a.273.273 0 0 0 .37-.113l2.197-4.272a.793.793 0 0 1 1.41 0l2.195 4.272a.273.273 0 0 0 .37.113l4.592-2.446a.793.793 0 0 1 1.16.702v4.232a.793.793 0 0 1-.332.651l-4.59 3.108a.273.273 0 0 0 .022.464l4.398 2.506a.793.793 0 0 1 .409.694v4.232a.793.793 0 0 1-1.16.702l-7.22-3.85a.273.273 0 0 0-.258 0l-7.22 3.85a.793.793 0 0 1-1.16-.702v-4.232a.793.793 0 0 1 .408-.694z"/></svg>
										Claude Connector
									</Badge>
								)}
								{storeSources.includes("official") && (
									<Badge variant="info" className="gap-1.5">
										<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
										Official
									</Badge>
								)}
							</div>
						)}

						<!-- CTA Buttons -->
						{(chatGptUrl || claudeListing?.storeUrl || app.mcpEndpointUrl || app.baseUrl) && (
						<div class="flex flex-wrap gap-3">
							{chatGptUrl && (
								<a
									href={chatGptUrl}
									target="_blank"
									rel="noopener noreferrer"
									class={buttonVariants({ size: "lg" })}
								>
									<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
										<polyline points="15 3 21 3 21 9"></polyline>
										<line x1="10" y1="14" x2="21" y2="3"></line>
									</svg>
									Open in ChatGPT
								</a>
							)}
							{claudeListing?.storeUrl && (
								<a
									href={claudeListing.storeUrl}
									target="_blank"
									rel="noopener noreferrer"
									class={buttonVariants({ variant: "outline", size: "lg", className: "border-amber-600/30 text-amber-700 hover:bg-amber-600/10 dark:text-amber-300" })}
								>
									<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
										<polyline points="15 3 21 3 21 9"></polyline>
										<line x1="10" y1="14" x2="21" y2="3"></line>
									</svg>
									View Claude connector
								</a>
							)}
							{!chatGptUrl && !claudeListing?.storeUrl && app.mcpEndpointUrl && (
								<a
									href={app.mcpEndpointUrl}
									target="_blank"
									rel="noopener noreferrer"
									class={buttonVariants({ size: "lg" })}
								>
									<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
										<polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
										<line x1="12" y1="22.08" x2="12" y2="12"></line>
									</svg>
									Connect
								</a>
							)}
							{app.baseUrl && (
								<a
									href={app.baseUrl}
									target="_blank"
									rel="noopener noreferrer"
									class={buttonVariants({ variant: "outline", size: "lg" })}
								>
									<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<circle cx="12" cy="12" r="10"></circle>
										<line x1="2" y1="12" x2="22" y2="12"></line>
