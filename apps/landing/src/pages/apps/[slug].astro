														<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
													</svg>
												)}
												{isGitHub && (
													<svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
														<path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
													</svg>
												)}
												{isDiscord && (
													<svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
														<path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"/>
													</svg>
												)}
												{isYouTube && (
													<svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
														<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
													</svg>
												)}
												{!isTwitter && !isLinkedIn && !isGitHub && !isDiscord && !isYouTube && (
													<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
														<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
														<polyline points="15 3 21 3 21 9"></polyline>
														<line x1="10" y1="14" x2="21" y2="3"></line>
													</svg>
												)}
											</a>
										);
									})}
								</div>
							</Card>
						)}
					</div>
				</div>

				<!-- ============================================================ -->
				<!-- ZONE 2: Publisher Intelligence                               -->
				<!-- ============================================================ -->

				<div id="publisher-intelligence" class="mt-16 scroll-mt-28 pt-12 border-t border-border/50">
					<div>
					<div class="max-w-4xl mx-auto mb-8">
						<h2 class="text-2xl font-bold font-display flex items-center gap-3">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M3 3v18h18"></path>
								<path d="m19 9-5 5-4-4-3 3"></path>
							</svg>
							Publisher Intelligence
						</h2>
						<p class="text-muted-foreground mt-2">
							Public trust signals for visitors and practical recommendations for publishers. Use this section to understand what Tedix can verify today and what would make the app easier for AI agents to find.
						</p>
					</div>
					</div>

					{publisherSignalCards.length > 0 && (
						<div>
						<div class="mb-8 grid gap-3 md:grid-cols-2 xl:grid-cols-4">
							{publisherSignalCards.map((signal) => (
								<Card className="p-4">
									<p class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">{signal.label}</p>
									<p class="mt-2 font-bold font-display text-2xl text-foreground">{signal.value}</p>
									<p class="mt-2 text-muted-foreground text-sm leading-relaxed">{signal.body}</p>
								</Card>
							))}
						</div>
						</div>
					)}

					<div class="grid gap-8 lg:grid-cols-3">
						<!-- Left Column: Server Status + Keywords + Model Context (2 cols) -->
						<div class="min-w-0 lg:col-span-2 space-y-8">

							<!-- Server Status (MCP apps only) -->
							{app.connectorType === "MCP" && (
								<Card className="p-6">
									<h2 class="text-xl font-semibold mb-4 flex items-center gap-2">
										<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
											<line x1="8" y1="21" x2="16" y2="21"></line>
											<line x1="12" y1="17" x2="12" y2="21"></line>
										</svg>
										Server Status
										{app.mcpServerName && (
											<span class="text-base font-normal text-muted-foreground ml-2">
												{app.mcpServerName}{app.mcpServerVersion && ` ${formatMcpServerVersion(app.mcpServerVersion)}`}
											</span>
										)}
									</h2>

									{/* Server Stats Grid */}
									{!isMcpHealthy ? (
										<div class="mb-4 grid gap-3 sm:grid-cols-3">
											<div class={`rounded-lg border p-3 ${isMcpAuthRequired ? "border-amber-500/25 bg-amber-500/10" : "border-red-500/20 bg-red-500/5"}`}>
												<p class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Live tools</p>
												<p class={`mt-1 font-semibold ${isMcpAuthRequired ? "text-amber-700 dark:text-amber-300" : "text-red-600 dark:text-red-400"}`}>
													{isMcpAuthRequired ? "OAuth required" : "Unavailable"}
												</p>
												<p class="mt-1 text-muted-foreground text-xs">
													{isMcpAuthRequired
														? "Tool execution requires user authorization."
														: "No verified tool inventory while the endpoint is failing."}
												</p>
											</div>
											<div class="rounded-lg border border-border/50 bg-muted/40 p-3">
												<p class="text-xs font-medium uppercase tracking-wide text-muted-foreground">
													{hasMcpDeclaredInventory ? "Declared tools" : "Resources"}
												</p>
												<p class="mt-1 font-semibold text-foreground">
													{hasMcpDeclaredInventory ? (app.mcpToolCount ?? 0) : "Not verified"}
												</p>
												<p class="mt-1 text-muted-foreground text-xs">
													{hasMcpDeclaredInventory
														? "Published in the server manifest."
														: "Resource discovery resumes after health checks recover."}
												</p>
											</div>
											<div class="rounded-lg border border-border/50 bg-muted/40 p-3">
												<p class="text-xs font-medium uppercase tracking-wide text-muted-foreground">
													{hasMcpDeclaredInventory ? "Live verification" : "Prompts"}
												</p>
												<p class="mt-1 font-semibold text-foreground">
													{hasMcpDeclaredInventory ? "Pending auth" : "Not verified"}
												</p>
												<p class="mt-1 text-muted-foreground text-xs">
													{hasMcpDeclaredInventory
														? "Tedix still needs endpoint access to execute MCP discovery."
														: "Prompt inventory is not shown until the MCP scan succeeds."}
												</p>
											</div>
										</div>
									) : (
										<div class="grid grid-cols-3 gap-3 sm:gap-4 mb-4">
											<div class="text-center p-3 rounded-lg bg-muted/50">
												<div class="text-2xl font-bold text-primary">
													{showMcpCounts && !mcpCountsEmpty
														? (app.mcpToolCount ?? 0).toLocaleString()
														: hasHealthCheck && mcpCountsEmpty
															? 0
															: "---"}
												</div>
												<div class="text-xs text-muted-foreground">
													{showMcpCounts && !mcpCountsEmpty
														? "Tools"
														: hasHealthCheck && mcpCountsEmpty
															? "No tools reported"
															: "Not scanned"}
												</div>
											</div>
											<div class="text-center p-3 rounded-lg bg-muted/50">
												<div class="text-2xl font-bold text-primary">
													{showMcpCounts && !mcpCountsEmpty
														? mcpResourceDisplayCount.toLocaleString()
														: hasHealthCheck && mcpCountsEmpty
															? 0
															: "---"}
												</div>
												<div class="text-xs text-muted-foreground">
													{showMcpCounts && !mcpCountsEmpty
														? "Resources"
														: hasHealthCheck && mcpCountsEmpty
															? "No resources"
															: "Not scanned"}
												</div>
											</div>
											<div class="text-center p-3 rounded-lg bg-muted/50">
												<div class="text-2xl font-bold text-primary">
													{showMcpCounts && !mcpCountsEmpty
														? (app.mcpPromptCount ?? 0).toLocaleString()
														: hasHealthCheck && mcpCountsEmpty
															? 0
															: "---"}
												</div>
												<div class="text-xs text-muted-foreground">
													{showMcpCounts && !mcpCountsEmpty
														? "Prompts"
														: hasHealthCheck && mcpCountsEmpty
															? "No prompts"
															: "Not scanned"}
												</div>
											</div>
										</div>
									)}

									{app.connectorType === "MCP" && !isMcpHealthy && (
										<p class={`mb-4 rounded-lg border p-3 text-sm leading-relaxed ${isMcpAuthRequired ? "border-amber-500/25 bg-amber-500/10 text-amber-800 dark:text-amber-200" : "border-red-500/20 bg-red-500/5 text-red-700 dark:text-red-300"}`}>
											{isMcpAuthRequired
												? "This endpoint is reachable but requires OAuth before Tedix can execute live MCP discovery. Public manifest metadata is shown when available; live tool calls still require user authorization."
												: hasMcpDeclaredInventory
													? "Tedix cannot execute live MCP discovery against this endpoint yet. Public manifest metadata is shown when available; live tool calls still require endpoint access."
												: "Tedix cannot currently verify this MCP endpoint. The listing metadata is still useful, but visitors should not assume live tools are available until health checks recover."}
										</p>
									)}

									{app.connectorType === "MCP" && isMcpHealthy && !hasHealthCheck && (
										<p class="text-xs text-muted-foreground mb-4">
											Tool discovery hasn&apos;t run yet for this server.
										</p>
									)}

									{app.connectorType === "MCP" && isMcpHealthy && hasHealthCheck && mcpCountsEmpty && (
										<p class={`mb-4 rounded-lg border p-3 text-sm leading-relaxed ${isMcpDegraded ? "border-amber-500/25 bg-amber-500/10 text-amber-800 dark:text-amber-200" : "border-border/50 bg-muted/40 text-muted-foreground"}`}>
											{isMcpDegraded
												? (app.healthErrorMessage ?? "The endpoint is reachable, but the last scan found no listable MCP tools, resources, templates, or prompts.")
												: "The endpoint is reachable, but the last scan found no listable MCP tools, resources, templates, or prompts."}
										</p>
									)}

									{app.connectorType === "MCP" && isMcpDegraded && hasHealthCheck && !mcpCountsEmpty && app.healthErrorMessage && (
										<p class="mb-4 rounded-lg border border-amber-500/25 bg-amber-500/10 p-3 text-sm leading-relaxed text-amber-800 dark:text-amber-200">
											{app.healthErrorMessage}
										</p>
									)}

									{/* Endpoint URL */}
									{app.baseUrl && (
										<div class="mb-4">
											<label class="text-xs font-medium text-muted-foreground uppercase tracking-wide mb-2 block">Endpoint</label>
											<div class="flex items-center gap-2 p-3 rounded-lg bg-muted font-mono text-sm break-all">
												<code class="flex-1" id="mcp-url">{app.baseUrl}</code>
											<button
												type="button"
												class={buttonVariants({ variant: "ghost", size: "xs", className: "flex-shrink-0" })}
													id="copy-mcp-url"
													title="Copy URL"
												>
													<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 copy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
														<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
														<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
													</svg>
													<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 check-icon hidden text-green-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
														<polyline points="20 6 9 17 4 12"></polyline>
													</svg>
												</button>
											</div>
										</div>
									)}

									{/* Last Health Check */}
									{app.healthLastCheckedAt && (
										<p class="text-xs text-muted-foreground mb-4">
											Last checked: {formatRelativeTime(app.healthLastCheckedAt)}
										</p>
									)}

									{/* MCP Instructions (if available) */}
									{app.mcpInstructions && (
										<div class="mt-4 p-3 rounded-lg bg-muted/50 border border-border/50">
											<h4 class="text-sm font-medium mb-2 flex items-center gap-2">
												<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
													<circle cx="12" cy="12" r="10"></circle>
													<path d="M12 16v-4"></path>
													<path d="M12 8h.01"></path>
												</svg>
												Server Instructions
											</h4>
											<p class="text-sm text-muted-foreground whitespace-pre-wrap">{app.mcpInstructions}</p>
										</div>
									)}

									{/* Technical Details (Expandable) */}
									{(app.healthConnectTimeMs !== null || app.healthErrorMessage) && (
									<details class="group mt-4">
										<summary
											class={buttonVariants({
												variant: "ghost",
												size: "sm",
												className: "w-fit cursor-pointer list-none gap-2 text-muted-foreground",
											})}
										>
												<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-open:rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
													<polyline points="9 18 15 12 9 6"></polyline>
												</svg>
												Technical Details
											</summary>
											<div class="mt-3 p-4 rounded-lg bg-muted/30 border border-border/30 space-y-3">
												{/* Connection Latency */}
												{app.healthConnectTimeMs !== null && (
													<div class="flex justify-between text-sm">
														<span class="text-muted-foreground">Connection Latency</span>
														<span class="font-mono">{formatLatency(app.healthConnectTimeMs)}</span>
													</div>
												)}

												{/* Uptime */}
												{app.healthUptimePercent !== null && (
													<div class="flex justify-between text-sm">
														<span class="text-muted-foreground">30-Day Uptime</span>
														<span class={`font-medium ${app.healthUptimePercent >= 99 ? "text-green-600 dark:text-green-400" : app.healthUptimePercent >= 95 ? "text-yellow-600 dark:text-yellow-400" : "text-red-600 dark:text-red-400"}`}>
															{app.healthUptimePercent.toFixed(1)}%
														</span>
													</div>
												)}

												{/* Error Message */}
												{app.healthErrorMessage && (
													<div class="pt-2 border-t border-border/30">
														<span class="text-xs font-medium text-red-600 dark:text-red-400 uppercase tracking-wide">Error</span>
														<p class="text-sm text-muted-foreground mt-1 font-mono break-all">{app.healthErrorMessage}</p>
													</div>
												)}
											</div>
									</details>
								)}
								</Card>
							)}

							<!-- MCP Tools Table -->
							{app.connectorType === "MCP" && app.tools && app.tools.length > 0 && (
								<ToolsTable client:idle tools={app.tools} />
							)}

							<!-- Keywords -->
							{((app.keywordsForDiscovery && app.keywordsForDiscovery.length > 0) || (app.keywordsForTriggering && app.keywordsForTriggering.length > 0)) && (
								<Card className="p-6">
									<h2 class="text-xl font-semibold mb-4 flex items-center gap-2">
										<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<line x1="4" y1="9" x2="20" y2="9"></line>
											<line x1="4" y1="15" x2="20" y2="15"></line>
											<line x1="10" y1="3" x2="8" y2="21"></line>
											<line x1="16" y1="3" x2="14" y2="21"></line>
										</svg>
										Keywords
									</h2>

									{app.keywordsForTriggering && app.keywordsForTriggering.length > 0 && (
										<div class="mb-4">
											<h3 class="text-sm font-medium text-muted-foreground mb-2">Trigger Keywords (@mentions)</h3>
											<div class="flex flex-wrap gap-2">
												{app.keywordsForTriggering.map((keyword) => (
													<code class="px-3 py-1 rounded-full text-sm font-mono bg-primary/10 text-primary">
														{keyword}
													</code>
												))}
											</div>
										</div>
									)}

									{app.keywordsForDiscovery && app.keywordsForDiscovery.length > 0 && (
										<div>
											<h3 class="text-sm font-medium text-muted-foreground mb-2">Discovery Keywords</h3>
											<div class="flex flex-wrap gap-2">
												{app.keywordsForDiscovery.map((keyword) => (
											<Badge variant="secondary">
												{keyword}
											</Badge>
												))}
											</div>
										</div>
									)}
								</Card>
							)}

							<!-- Model Description -->
							{appModelDescription && appModelDescription !== appDescription && (
								<Card className="p-6">
									<h2 class="text-xl font-semibold mb-4 flex items-center gap-2">
										<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<circle cx="12" cy="12" r="10"></circle>
											<path d="M12 16v-4"></path>
											<path d="M12 8h.01"></path>
										</svg>
										Model Context
									</h2>
									<p class="text-muted-foreground leading-relaxed whitespace-pre-wrap text-sm">
										{appModelDescription}
									</p>
								</Card>
							)}
						</div>

						<!-- Right Column: Discoverability + Tips + Technical Details (1 col) -->
						<div class="space-y-6 lg:sticky lg:top-24 self-start">

							<!-- Discoverability Score -->
							{discoverability && (
								<Card className="p-5">
									<h3 class="text-sm font-semibold text-muted-foreground mb-3 uppercase tracking-wide">Discoverability Score</h3>
									<div class="mb-4 space-y-3">
										<div class="flex items-baseline justify-between gap-4">
											<p class={`text-lg font-bold ${discoverabilityColorClass}`}>{discoverability.label}</p>
											<p class="font-semibold tabular-nums">{discoverabilityScore} / 100</p>
										</div>
										<Progress value={discoverabilityScore} aria-label={`${app.name} discoverability score: ${discoverabilityScore} of 100`} />
										<p class="text-xs text-muted-foreground">How easily AI agents can find this app from its current catalog metadata.</p>
									</div>
									<ul class="space-y-2">
										{discoverability.criteria.map((c) => {
											const meetsThreshold = c.score / c.max >= 0.65;
											return (
												<li class="flex items-center justify-between gap-3 text-sm">
													<div class="flex items-center gap-2 min-w-0">
														{meetsThreshold ? (
															<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-green-500 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
																<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
																<polyline points="22 4 12 14.01 9 11.01"></polyline>
															</svg>
														) : (
															<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-muted-foreground/40 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
																<circle cx="12" cy="12" r="10"></circle>
															</svg>
														)}
														<span class={meetsThreshold ? "text-foreground" : "text-muted-foreground"}>{c.label}</span>
													</div>
													<span class="text-xs text-muted-foreground tabular-nums">{c.score}/{c.max}</span>
												</li>
											);
										})}
									</ul>
								</Card>
							)}

							<!-- How to Improve -->
							{discoverability && discoverability.tips.length > 0 && (
								<Card className="p-5">
									<h3 class="text-sm font-semibold text-muted-foreground mb-3 uppercase tracking-wide flex items-center gap-2">
										<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 1 1 7.072 0l-.548.547A3.374 3.374 0 0 0 14 18.469V19a2 2 0 1 1-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
										</svg>
										How to Improve
									</h3>
									<div class="space-y-2">
										{discoverability.tips.map((t) => (
											<div class={`border-l-2 ${t.priority === "high" ? "border-l-red-500" : t.priority === "medium" ? "border-l-yellow-500" : "border-l-blue-500"} pl-3 py-1`}>
												<p class="text-xs text-muted-foreground leading-relaxed">{t.tip}</p>
											</div>
										))}
									</div>
									<a href="https://blog.tedix.dev/posts/chatgpt-app-discoverability-guide/" class="inline-flex items-center gap-1 text-xs text-primary hover:underline mt-3">
										Read the full discoverability guide &rarr;
									</a>
								</Card>
							)}

							<!-- Technical Details (collapsed App Snapshot + Details + Auth) -->
							<Card className="p-5">
								<h3 class="text-sm font-semibold text-muted-foreground mb-3 uppercase tracking-wide">Technical Details</h3>
								<dl class="space-y-3 text-sm">
									{app.status && (
										<div class="flex items-center justify-between gap-3">
											<dt class="text-muted-foreground">Status</dt>
											<dd class={`font-medium ${app.status === "ENABLED" ? "text-green-600 dark:text-green-400" : app.status === "DISABLED" ? "text-red-600 dark:text-red-400" : "text-amber-600 dark:text-amber-400"}`}>
												{app.status ?? "Unknown"}
											</dd>
										</div>
									)}
									{app.connectorType && (
										<div class="flex items-center justify-between gap-3">
											<dt class="text-muted-foreground">Type</dt>
											<dd class="font-medium">{CONNECTOR_TYPE_LABELS_FRIENDLY[app.connectorType] || CONNECTOR_TYPE_LABELS[app.connectorType] || app.connectorType}</dd>
										</div>
									)}
									<div class="flex items-center justify-between gap-3">
										<dt class="text-muted-foreground">Auth</dt>
										<dd class="font-medium">
											{app.authTypes && app.authTypes.length > 0
												? app.authTypes.map(t => AUTH_TYPE_LABELS[t] || t).join(", ")
												: "Open Access"}
										</dd>
									</div>
									{storeSources.length > 0 && (
										<div class="flex items-center justify-between gap-3">
											<dt class="text-muted-foreground">Listed on</dt>
											<dd class="flex flex-wrap gap-1.5">
												{storeSources.includes("chatgpt") && (
											<Badge variant="success">ChatGPT</Badge>
												)}
												{storeSources.includes("claude") && (
											<Badge variant="warning">Claude Connector</Badge>
												)}
												{storeSources.includes("official") && (
											<Badge variant="info">Official</Badge>
												)}
											</dd>
										</div>
									)}
									{(app.sourceCreatedAt || app.createdAt) && (
										<div class="flex items-center justify-between gap-3">
											<dt class="text-muted-foreground">Added</dt>
											<dd class="font-medium">{formatDate(app.sourceCreatedAt || app.createdAt)}</dd>
										</div>
									)}
									{app.lastSyncedAt && (
										<div class="flex items-center justify-between gap-3">
											<dt class="text-muted-foreground">Last synced</dt>
											<dd class="font-medium">{formatRelativeTime(app.lastSyncedAt)}</dd>
										</div>
									)}
									{app.healthLastCheckedAt && (
										<div class="flex items-center justify-between gap-3">
											<dt class="text-muted-foreground">Last checked</dt>
											<dd class="font-medium">{formatRelativeTime(app.healthLastCheckedAt)}</dd>
										</div>
									)}
									{app.mcpServerVersion && (
										<div class="flex items-center justify-between gap-3">
											<dt class="text-muted-foreground">Version</dt>
											<dd class="font-medium">{app.mcpServerVersion}</dd>
										</div>
									)}
									{app.distributionChannel && (
										<div class="flex items-center justify-between gap-3">
											<dt class="text-muted-foreground">Distribution</dt>
											<dd class="font-medium text-right">{app.distributionChannel.replace(/_/g, " ").toLowerCase().replace(/\b\w/g, c => c.toUpperCase())}</dd>
										</div>
									)}
								</dl>
							</Card>
						</div>
					</div>
				</div>

				<!-- Related Apps -->
				{relatedApps.length > 0 && (
					<section class="mt-12">
						<h2 class="text-xl font-semibold mb-4 flex items-center gap-2">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<rect x="3" y="3" width="7" height="7"></rect>
								<rect x="14" y="3" width="7" height="7"></rect>
								<rect x="3" y="14" width="7" height="7"></rect>
								<rect x="14" y="14" width="7" height="7"></rect>
							</svg>
							Related Apps
							{app.category && (
								<span class="text-sm font-normal text-muted-foreground">
									in {CATEGORY_LABELS[app.category] || app.category}
								</span>
							)}
						</h2>
						<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
							{relatedApps.map((related, idx) => {
								const relLogo = resolveLogoUrl(related.logoUrl);
								const relHealth = related.healthStatus ? HEALTH_STATUS_CONFIG[related.healthStatus] : null;
								return (
									<Card className="rounded-xl">
									<a href={`/apps/${related.slug || related.id}/`} class="group block p-4">
										<div class="flex items-center gap-3 mb-2">
											<div class="w-10 h-10 rounded-lg flex-shrink-0 overflow-hidden bg-muted flex items-center justify-center">
												{relLogo ? (
													<img src={relLogo} alt="" class="w-full h-full object-cover" loading="lazy" />
												) : (
													<span class="text-xs font-bold text-muted-foreground">{related.name.charAt(0)}</span>
												)}
											</div>
											<div class="min-w-0">
												<div class="flex items-center gap-1.5">
													<span class="text-sm font-medium text-foreground group-hover:text-primary transition-colors truncate">{related.name}</span>
													{relHealth && related.connectorType === "MCP" && (
														<span class={`w-1.5 h-1.5 rounded-full flex-shrink-0 ${relHealth.dotColor}`}></span>
													)}
												</div>
												{related.developer && (
													<span class="text-xs text-muted-foreground truncate block">{related.developer}</span>
												)}
											</div>
										</div>
										{cleanPublicText(related.description) && (
											<p class="text-xs text-muted-foreground line-clamp-2">{cleanPublicText(related.description)}</p>
										)}
									</a>
									</Card>
								);
							})}
						</div>
					</section>
				)}

				<!-- Attribution -->
				<footer class="mt-12 pt-8 border-t border-border/50 text-center text-sm text-muted-foreground">
					<p>
						All app names, logos, and trademarks belong to their respective owners.
					</p>
				</footer>
			</div>
		)}
	</div>

	<!-- Copy Button Script -->
	<script>
		const copyBtn = document.getElementById('copy-mcp-url');
		const mcpUrl = document.getElementById('mcp-url');

		if (copyBtn && mcpUrl) {
			copyBtn.addEventListener('click', async () => {
				const textToCopy = mcpUrl.textContent;
				if (textToCopy) {
					try {
						await navigator.clipboard.writeText(textToCopy);
						// Toggle icons for visual feedback
						const copyIcon = copyBtn.querySelector('.copy-icon');
						const checkIcon = copyBtn.querySelector('.check-icon');
						if (copyIcon && checkIcon) {
							copyIcon.classList.add('hidden');
							checkIcon.classList.remove('hidden');
							setTimeout(() => {
								copyIcon.classList.remove('hidden');
								checkIcon.classList.add('hidden');
							}, 2000);
						}
					} catch (err) {
						console.error('Failed to copy:', err);
					}
				}
			});
		}
	</script>

</BaseLayout>
