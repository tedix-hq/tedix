				<p>
					Tedix GbR<br />
					Vertreten durch die Gesellschafter:<br />
					Aaron Koivunen<br />
					Adriana Carmona Beltran
				</p>
			</section>

			<section>
				<h2 class="text-2xl font-semibold mb-4">Postanschrift</h2>
				<p>
					Winterfeldtstraße 21<br />
