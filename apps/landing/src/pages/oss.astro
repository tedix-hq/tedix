---
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = true;
---

<BaseLayout
	title="Tedix is open source — AI coworkers that show their work"
	description="Tedix gives your team AI coworkers for recurring work. They ask before risky steps and leave a record of every run. The complete product is open source on GitHub under AGPL-3.0."
	includeSoftwareApplicationSchema={false}
	includeWebPageSchema={false}
>
	<div class="oss-page">
		<header class="oss-hero">
			<p class="eyebrow">Open source · AGPL-3.0</p>
			<h1>AI coworkers that<br /><span>show their work.</span></h1>
			<p class="intro">
				Tedix gives your team AI coworkers, called tedis, for recurring work.
				They ask before risky steps, and every run leaves a record: what the
				tedi did, which tools it used, and who approved it. The complete product
				is on GitHub, not a reduced community edition.
			</p>
			<div class="actions">
				<a class="cta cta-primary" href="https://github.com/tedix-hq/tedix"
					>View on GitHub</a
				>
				<a class="cta cta-secondary" href="https://docs.tedix.dev/getting-started"
					>Get started</a
				>
			</div>
		</header>

		<section class="benefits" aria-label="What is in the repository">
			<article>
				<h2>Workers that stay with you</h2>
				<p>
					Each tedi keeps its identity, memory, skills and policies across runs,
					so work carries from one run to the next.
				</p>
			</article>
			<article>
				<h2>Tools as configuration</h2>
				<p>
					Connect your systems through MCP. Tools, widgets and policies are
					configuration, not one handler per tool.
				</p>
			</article>
			<article>
				<h2>Work you can check</h2>
				<p>
					Open any run to see the worker, the tools it used, the approval and
					the result. Nobody approves their own request.
				</p>
			</article>
		</section>

		<section class="quickstart" aria-label="Run Tedix locally">
			<h2>Run it on your machine</h2>
			<pre><code>git clone https://github.com/tedix-hq/tedix.git && cd tedix
bun run-local</code></pre>
			<p>
				Needs Git, Bun and Node.js 22+. No account, no cloud credentials and no
				model calls by default. Tedix OS opens at localhost:3030.
			</p>
		</section>

		<p class="availability">
			Source: public under AGPL-3.0, with some packages under Apache-2.0 or
			MIT. Tedix Cloud: invited beta. Self-hosting: experimental. See
			<a href="https://docs.tedix.dev/release-status">release status</a>. Ask
			questions in
			<a href="https://github.com/tedix-hq/tedix/discussions">GitHub Discussions</a
			>. Report security issues privately to
			<a href="mailto:security@tedix.dev">security@tedix.dev</a>.
		</p>
	</div>
</BaseLayout>

<style>
	.oss-page {
		background:
			radial-gradient(
				ellipse at 50% 0,
				color-mix(in oklab, var(--primary) 8%, transparent),
				transparent 65%
			),
			var(--background);
		color: var(--foreground);
		padding: 144px 24px 72px;
	}
	.oss-hero,
	.benefits,
	.availability {
		max-width: 1080px;
		margin-inline: auto;
	}
	.oss-hero {
		text-align: center;
		margin-bottom: 64px;
	}
	.eyebrow {
		color: var(--primary);
		font-size: 0.85rem;
		font-weight: 600;
		margin: 0 0 24px;
	}
	h1 {
		font-size: clamp(2.5rem, 6vw, 4.6rem);
		font-weight: 700;
		letter-spacing: -0.045em;
		line-height: 1.08;
		margin: 0 0 24px;
	}
	h1 span {
		color: var(--primary);
	}
	.intro {
		color: var(--muted-foreground);
		font-size: clamp(1rem, 2vw, 1.18rem);
		line-height: 1.7;
		max-width: 58ch;
		margin: 0 auto 32px;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 12px;
	}
	.cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 48px;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 12px 24px;
		font-weight: 600;
		text-decoration: none;
	}
	.cta-primary {
		background: var(--primary);
		border-color: var(--primary);
		color: var(--primary-foreground);
	}
	.cta-secondary {
		background: var(--background);
		color: var(--foreground);
	}
	.cta:hover {
		filter: brightness(0.95);
	}
	.cta:focus-visible {
		outline: 2px solid var(--ring);
		outline-offset: 4px;
	}
	.benefits {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 20px;
	}
	.benefits article {
		background: var(--card);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 28px;
	}
	h2 {
		font-size: 1.1rem;
		font-weight: 600;
		line-height: 1.4;
		margin: 0 0 12px;
	}
	.benefits p,
	.availability {
		color: var(--muted-foreground);
		font-size: 0.94rem;
		line-height: 1.7;
	}
	.benefits p {
		margin: 0;
	}
	.availability {
		text-align: center;
		font-size: 0.82rem;
		margin-top: 32px;
	}
	.quickstart {
		max-width: 720px;
		margin: 48px auto 0;
		text-align: center;
	}
	.quickstart pre {
		background: var(--card);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 20px 24px;
		margin: 0 0 12px;
		overflow-x: auto;
		text-align: left;
		font-size: 0.9rem;
		line-height: 1.6;
	}
	.quickstart p {
		color: var(--muted-foreground);
		font-size: 0.9rem;
		line-height: 1.6;
		margin: 0;
	}
	.availability a {
		color: inherit;
		text-decoration: underline;
	}
	@media (max-width: 720px) {
		.oss-page {
			padding: 120px 20px 48px;
		}
		.oss-hero {
			margin-bottom: 40px;
		}
		.benefits {
			grid-template-columns: 1fr;
			gap: 12px;
		}
		.benefits article {
			padding: 24px;
		}
	}
</style>
