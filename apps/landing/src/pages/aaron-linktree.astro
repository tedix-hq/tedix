---

<BaseLayout title="Aaron Koivunen | Tedix" description="Curated founder profile links for Aaron Koivunen." showConsentBanner={false} showFooter={false} includeSoftwareApplicationSchema={false}>
	<main class="min-h-screen bg-[linear-gradient(180deg,rgba(245,240,255,0.95)_0%,rgba(255,255,255,1)_42%,rgba(255,248,244,0.92)_100%)] px-4 pt-32 pb-14 dark:bg-[linear-gradient(180deg,#090015_0%,#0d0617_52%,#120817_100%)] sm:px-6 lg:px-8">
		<section class="mx-auto max-w-3xl text-center">
			<img src="/images/founders/aaron-koivunen.jpeg" alt="Aaron Koivunen" class="mx-auto h-28 w-28 rounded-[2rem] border border-white/80 object-cover shadow-[0_22px_60px_rgba(124,58,237,0.22)] dark:border-white/10" />
			<p class="mt-7 text-sm font-semibold uppercase tracking-[0.24em] text-violet-600 dark:text-violet-300">Founder Profile</p>
			<h1 class="mt-3 font-display text-4xl font-bold tracking-tight text-foreground dark:text-white/95">Aaron Koivunen</h1>
			<p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-muted-foreground dark:text-white/62">
				Founder evidence for EuroLabs reviewers: AI worker architecture, MCP implementation, public speaking, builder credibility and European AI ecosystem leadership.
			</p>
			<div class="mt-8 grid gap-3 sm:grid-cols-3">
				{profileLinks.map((link) => {
					const Icon = link.icon;
					return (
						<a href={link.href} target="_blank" rel="noreferrer" class="group flex items-center justify-between rounded-2xl border border-border/80 bg-white/82 px-5 py-4 text-left font-semibold text-foreground shadow-[0_14px_45px_rgba(15,23,42,0.07)] backdrop-blur-xl transition-all hover:-translate-y-0.5 hover:border-violet-400/45 dark:border-white/10 dark:bg-white/[0.045] dark:text-white/92">
							<span class="inline-flex items-center gap-3"><Icon className="h-5 w-5 text-violet-600 dark:text-violet-300" />{link.label}</span>
							<ArrowRight className="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
						</a>
					);
				})}
			</div>
		</section>

		<div class="mx-auto mt-12 grid max-w-6xl gap-6">
			{orderedSections.map((section) => {
				const Icon = section.icon;
				return (
					<section class="rounded-[2rem] border border-border/80 bg-white/82 p-6 shadow-[0_18px_60px_rgba(15,23,42,0.08)] backdrop-blur-xl dark:border-white/10 dark:bg-white/[0.045]">
						<div class="mb-5 flex items-center gap-3">
							<h2 class="inline-flex max-w-full items-center gap-3 rounded-full border border-orange-300/80 bg-orange-50/70 px-5 py-3 text-left text-sm font-bold uppercase tracking-[0.18em] text-orange-700 shadow-[0_12px_34px_rgba(251,146,60,0.14)] dark:border-orange-300/35 dark:bg-orange-400/10 dark:text-orange-200 sm:tracking-[0.22em]">
								<Icon className="h-5 w-5 shrink-0" />
								<span class="min-w-0 leading-snug">{section.title}</span>
							</h2>
						</div>
						<div class="grid gap-4 md:grid-cols-2">
							{section.items.map((item) => (
								<a href={item.href} target="_blank" rel="noreferrer" class="group flex items-start gap-4 rounded-2xl border border-border/75 bg-background/72 p-4 transition-all hover:-translate-y-0.5 hover:border-violet-400/45 dark:border-white/10 dark:bg-white/[0.035]">
									{item.thumbnail ? (
										<img src={item.thumbnail} alt="" loading="lazy" referrerpolicy="no-referrer" class="h-20 w-20 shrink-0 rounded-xl border border-border/70 object-cover shadow-sm transition-transform group-hover:scale-[1.02] dark:border-white/10 sm:h-24 sm:w-24" />
									) : item.thumbnailLabel ? (
										<div class="flex h-20 w-20 shrink-0 items-center justify-center rounded-xl border border-violet-200/80 bg-gradient-to-br from-violet-50 via-fuchsia-50 to-orange-50 px-3 text-center shadow-sm dark:border-white/10 dark:from-violet-500/15 dark:via-fuchsia-500/10 dark:to-orange-500/10 sm:h-24 sm:w-24">
											<span class="font-display text-[0.72rem] font-bold leading-tight text-violet-700 dark:text-violet-100">{item.thumbnailLabel}</span>
										</div>
									) : null}
									<div class="min-w-0 flex-1">
										<h3 class="font-display text-lg font-bold text-foreground dark:text-white/95">{item.title}</h3>
										<p class="mt-2 text-sm leading-relaxed text-muted-foreground dark:text-white/60">{item.description}</p>
										<span class="mt-4 inline-flex items-center text-sm font-semibold text-violet-600 dark:text-violet-300">Open link <ArrowRight className="ml-1 h-4 w-4 transition-transform group-hover:translate-x-0.5" /></span>
									</div>
								</a>
							))}
						</div>
					</section>
				);
			})}
		</div>
	</main>
</BaseLayout>
