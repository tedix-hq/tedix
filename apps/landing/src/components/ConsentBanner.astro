---
import ConsentBannerIsland from "./consent/ConsentBannerIsland.tsx";
import { defaultLocale, getLocaleContent, type Locale } from "../i18n/content";

interface Props {
	locale?: Locale;
	variant?: "default" | "compact";
}

const { locale = defaultLocale, variant = "default" } = Astro.props;
const content = getLocaleContent(locale).consent;
const compactLabels: Record<Locale, { accept: string; reject: string }> = {
	en: { accept: "Accept", reject: "Reject" },
	de: { accept: "Akzeptieren", reject: "Ablehnen" },
	es: { accept: "Aceptar", reject: "Rechazar" },
};
const compactLabel = compactLabels[locale] ?? compactLabels.en;
---

<ConsentBannerIsland client:load content={content} variant={variant} compactLabel={compactLabel} />
