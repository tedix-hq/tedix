---
import { Image } from "astro:assets";
import challengeComplexity from "../../public/images/challenges/complexity.png";
import challengeRisks from "../../public/images/challenges/risks.png";
import challengeSilos from "../../public/images/challenges/silos.png";
import integrationLayer from "../../public/images/ai-integration-layer.png";
import geoTedix from "../../public/images/geo-tedix.png";
import soloFounder from "../../public/images/solo-founder.png";
import mimextrade from "../../public/images/mimextrade.png";
import { buttonVariants } from "@/components/ui/button";
import { Card } from "@/components/ui/card";
import { cn } from "@/lib/utils";
import { BorderBeam } from "./magicui/BorderBeam.tsx";
import { Particles } from "./magicui/Particles.tsx";
import { BlurFade } from "./magicui/BlurFade.tsx";
import { AnimatedGradientText } from "./magicui/AnimatedGradientText.tsx";
import { Marquee } from "./magicui/Marquee.tsx";
import { NumberTicker } from "./magicui/NumberTicker.tsx";
import { ShimmerButton } from "./magicui/ShimmerButton.tsx";
import { TextAnimate } from "./magicui/TextAnimate.tsx";
import { HeroBrain } from "./landing/HeroBrain.tsx";
import { OperationalTimeline } from "./landing/OperationalTimeline.tsx";
import { PlatformBeams } from "./landing/PlatformBeams.tsx";
import { ChatGPTDemo } from "./landing/ChatGPTDemo.tsx";
import { IntegrationWorkflow } from "./landing/IntegrationWorkflow.tsx";
import { TediDashboardShowcase } from "./landing/TediDashboardShowcase.tsx";
import { SystemIntegrationDemo, ContentDemo, SoloFounderDemo, RapidDeployDemo } from "./landing/UseCaseDemos.tsx";
import type { HomeContent, Locale } from "../i18n/content";

interface Props {
	content: HomeContent;
	locale: Locale;
}

const { content: t, locale } = Astro.props;
const illustrationLabel = locale === "de"
	? "Illustration — keine Kundenaussage oder Leistungsmessung."
	: locale === "es"
		? "Ilustración — no es un testimonio ni una medición de resultados."
		: "Illustration — not a customer testimonial or measured result.";

import { PRODUCT_AUTH_URL } from "../lib/product-urls";
const heroLinks = t.hero as typeof t.hero & {
	primaryHref?: string;
	secondaryHref?: string;
};
const primaryHeroHref = heroLinks.primaryHref ?? PRODUCT_AUTH_URL;
const secondaryHeroHref = heroLinks.secondaryHref ?? "#how-it-works";
const useCasesConfig = t.useCases as typeof t.useCases & {
	visualMode?: "eurolabs";
};
const isEuroLabsResearch = useCasesConfig.visualMode === "eurolabs";

// Only the EuroLabs page frames itself with a challenge section; the
// localized homepage leads straight from the hero into the work.
interface ChallengeCard {
	badge: string;
	title: string;
	description: string;
	alt: string;
}
interface ChallengeContent {
	eyebrow: string;
	title: string;
	description: string;
	cards: readonly [ChallengeCard, ChallengeCard, ChallengeCard];
	closingPrefix: string;
	closingAccent: string;
}
const challenge = (t as typeof t & { challenge?: ChallengeContent }).challenge;
---

<div class="relative flex min-h-screen flex-col">
  <!-- ═══════════════════════════════════════════
       SECTION 1 — HERO (Dark Neural Theme)
       ═══════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-gradient-to-b from-violet-50 via-background to-background pt-28 pb-24 md:pt-32 md:pb-32 lg:min-h-[90vh] lg:pt-36 lg:pb-40 dark:from-[#080016] dark:via-[#080016] dark:to-[#0a0012]">
    <!-- Deep gradient backdrop (dark only) -->
    <div class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-b from-violet-100/50 via-transparent to-transparent dark:from-[#0c0020] dark:via-[#080016] dark:to-[#0a0012]"></div>
    <!-- Subtle grid pattern -->
    <div class="pointer-events-none absolute inset-0 -z-10 opacity-[0.04] dark:opacity-[0.06]" style="background-image: linear-gradient(rgba(139,92,246,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(139,92,246,0.5) 1px, transparent 1px); background-size: 48px 48px;"></div>
    <!-- Ambient violet particles -->
    <Particles client:only="react" quantity={50} color="#a78bfa" size={0.5} staticity={40} ease={60} className="pointer-events-none absolute inset-0 -z-[5]" />
    <!-- Horizontal scan line -->
    <div class="pointer-events-none absolute inset-x-0 top-0 z-[1] h-px bg-gradient-to-r from-transparent via-violet-500/20 to-transparent dark:via-violet-500/40" style="animation: scanLine 8s ease-in-out infinite;"></div>

    <!-- Brain visual — scoped to the same centered frame as the hero copy -->
    <div class="hero-composition-frame pointer-events-none absolute inset-y-0 left-1/2 z-10 hidden -translate-x-1/2 lg:block">
      <HeroBrain client:only="react" className="overflow-visible" />
    </div>

    <div class="hero-composition-frame relative z-20 mx-auto px-4 sm:px-6 lg:px-8">
      <div class="pointer-events-none relative -mx-4 mb-6 h-[228px] overflow-hidden sm:mx-0 sm:h-[280px] lg:hidden">
        <HeroBrain client:only="react" variant="mobile" className="overflow-hidden" />
      </div>
      <div class="max-w-xl lg:max-w-2xl">
        <BlurFade client:only="react" delay={0.3} direction="up">
          <h1 class="mb-8 font-bold font-display text-4xl leading-[1.08] tracking-tight sm:text-5xl md:text-6xl lg:text-[4.5rem]">
            <span class="text-foreground dark:text-white/95">{t.hero.line1}</span>
            <br />
            <span class="text-foreground dark:text-white/95">{t.hero.line2}</span>
            <br />
            <span class="bg-gradient-to-r from-violet-600 via-fuchsia-500 to-orange-500 bg-clip-text text-transparent dark:from-violet-400 dark:via-fuchsia-400 dark:to-orange-400">{t.hero.line3}</span>
          </h1>
        </BlurFade>

        <BlurFade client:only="react" delay={0.45} direction="up">
          <p class="mb-5 max-w-lg font-semibold text-xl leading-snug text-foreground md:text-2xl dark:text-white/90">
            {t.hero.subtitleIntro}{" "}
            <span class="bg-gradient-to-r from-violet-600 via-fuchsia-500 to-orange-500 bg-clip-text text-transparent dark:from-violet-400 dark:via-fuchsia-400 dark:to-orange-400">
              {t.hero.subtitleHighlight}
            </span>
          </p>
          <p class="mb-12 max-w-lg text-base leading-relaxed text-muted-foreground dark:text-white/60">
            {t.hero.description}
          </p>
        </BlurFade>

        <BlurFade client:only="react" delay={0.6} direction="up">
          <div class="flex flex-col items-stretch gap-4 sm:flex-row sm:items-center">
            <div class="cta-pulse-ring w-full sm:w-fit">
              <a href={primaryHeroHref} class="block w-full sm:w-auto">
                <ShimmerButton client:only="react" shimmerColor="#c084fc" shimmerSize="0.08em" background="linear-gradient(135deg, #7c3aed, #c026d3, #ea580c)" borderRadius="9999px" className="w-full px-6 py-3 text-base font-semibold shadow-lg shadow-violet-500/25 sm:w-auto sm:px-8">
                  {t.hero.primaryCta}
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-2 h-4 w-4 transition-transform group-hover:translate-x-0.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </ShimmerButton>
              </a>
            </div>
            <a href={secondaryHeroHref} class="inline-flex items-center justify-center rounded-full border border-border bg-background/60 px-8 py-3 text-base font-semibold text-foreground shadow-sm backdrop-blur-sm transition-colors hover:bg-muted dark:border-white/15 dark:bg-white/5 dark:text-white dark:hover:bg-white/10">
              {t.hero.secondaryCta}
            </a>
          </div>
        </BlurFade>

        <!-- Trust signals -->
        <BlurFade client:only="react" delay={0.75} direction="up">
          <div class="mt-12 flex flex-wrap items-center gap-x-7 gap-y-3">
            <div class="flex items-center gap-2 text-muted-foreground text-sm dark:text-white/55">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-violet-400"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              <span>{t.hero.trustSignals[0]}</span>
            </div>
            <div class="flex items-center gap-2 text-muted-foreground text-sm dark:text-white/55">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-fuchsia-400"><path d="M3 9h18v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9Z"/><path d="m3 9 2.45-4.9A2 2 0 0 1 7.24 3h9.52a2 2 0 0 1 1.8 1.1L21 9"/><path d="M12 3v6"/></svg>
              <span>{t.hero.trustSignals[1]}</span>
            </div>
            <div class="flex items-center gap-2 text-muted-foreground text-sm dark:text-white/55">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-orange-400"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
              <span>{t.hero.trustSignals[2]}</span>
            </div>
            <div class="flex items-center gap-2 text-muted-foreground text-sm dark:text-white/55">
              <span class="text-base">&#127465;&#127466;</span>
              <span>{t.hero.trustSignals[3]}</span>
            </div>
          </div>
        </BlurFade>
      </div>
    </div>

    <!-- Invite-Only badge — bottom right -->
    <div class="hero-composition-frame pointer-events-none absolute inset-y-0 left-1/2 z-30 hidden -translate-x-1/2 lg:block">
      <div class="absolute right-[8%] bottom-[12%]">
        <BlurFade client:only="react" delay={1} direction="up">
          <div class="inline-flex items-center gap-2 rounded-full border border-fuchsia-400/30 bg-fuchsia-500/15 px-4 py-1.5 shadow-[0_0_20px_rgba(217,70,239,0.25)] backdrop-blur-sm">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-fuchsia-400 opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-fuchsia-400"></span>
            </span>
            <span class="text-xs font-semibold text-fuchsia-600 tracking-wide dark:text-fuchsia-300">{t.hero.betaBadge}</span>
          </div>
        </BlurFade>
      </div>
    </div>

    <!-- Bottom gradient fade to next section -->
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-background to-transparent dark:from-background"></div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 2 — THE CHALLENGE (EuroLabs only)
       ═══════════════════════════════════════════ -->
  {challenge ? (
  <section class="relative pt-4 pb-8 md:pt-5 md:pb-10" id="what-a-tedi-does">
    <div class="landing-section-frame mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mx-auto">
        <div class="mb-7 text-center">
          <p class="mb-4 font-medium text-violet-600 text-sm uppercase tracking-[0.2em] dark:text-violet-400">{challenge.eyebrow}</p>
          <h2 class="mb-5 font-bold font-display text-3xl leading-tight tracking-tight md:text-4xl lg:text-5xl">
            {challenge.title}
          </h2>
          <p class="mx-auto max-w-2xl text-muted-foreground text-lg leading-relaxed">
            {challenge.description}
          </p>
        </div>

        <div class="grid gap-5 md:grid-cols-3 md:gap-6">
          <!-- COMPLEXITY pair: challenge box, then corresponding image below -->
          <div class="flex flex-col gap-5 md:gap-6">
            <Card className="group relative min-h-[270px] overflow-hidden border-violet-200/60 bg-white p-7 transition-transform duration-300 hover:-translate-y-1 dark:border-violet-800/30 dark:bg-violet-950/20 motion-reduce:transform-none motion-reduce:transition-none">
              <div class="absolute inset-x-0 top-0 h-1 rounded-t-2xl bg-gradient-to-r from-violet-600 to-violet-400"></div>
              <div class="mb-5 flex items-center gap-3">
                <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-violet-100 text-violet-600 dark:bg-violet-900/40 dark:text-violet-400">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                </div>
                <span class="challenge-badge inline-flex items-center rounded-md bg-violet-600 px-3 py-1 text-[11px] font-bold uppercase tracking-widest text-white shadow-sm shadow-violet-500/40">{challenge.cards[0].badge}</span>
              </div>
              <h3 class="challenge-title mb-3 font-bold font-display text-xl text-foreground transition-colors group-hover:text-violet-700 dark:group-hover:text-violet-300 md:text-2xl">{challenge.cards[0].title}</h3>
              <p class="text-muted-foreground text-sm leading-relaxed">{challenge.cards[0].description}</p>
            </Card>
            <figure class="challenge-visual group relative min-h-[270px] overflow-hidden rounded-2xl border border-violet-200/60 bg-white shadow-sm dark:border-violet-800/30 dark:bg-violet-950/20">
              <img src="/images/challenges/complexity-light.jpg" alt={challenge.cards[0].alt} loading="lazy" class="h-full min-h-[270px] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03] dark:hidden" />
              <Image src={challengeComplexity} layout="none" format="webp" widths={[320, 640, 960, 1280]} sizes="(min-width: 1312px) 389px, (min-width: 1024px) calc((100vw - 144px) / 3), (min-width: 768px) calc((100vw - 128px) / 3), (min-width: 640px) calc(100vw - 80px), calc(100vw - 64px)" alt={challenge.cards[0].alt} loading="lazy" class="hidden h-full min-h-[270px] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03] dark:block" />
            </figure>
          </div>

          <!-- RISKS pair: corresponding image first, then challenge box below -->
          <div class="flex flex-col gap-5 md:flex-col-reverse md:gap-6">
            <Card className="group relative min-h-[270px] overflow-hidden border-rose-200/60 bg-white p-7 transition-transform duration-300 hover:-translate-y-1 dark:border-rose-800/30 dark:bg-rose-950/20 motion-reduce:transform-none motion-reduce:transition-none">
              <div class="absolute inset-x-0 top-0 h-1 rounded-t-2xl bg-gradient-to-r from-rose-600 to-rose-400"></div>
              <div class="mb-5 flex items-center gap-3">
                <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-rose-100 text-rose-600 dark:bg-rose-900/40 dark:text-rose-400">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
                </div>
                <span class="challenge-badge inline-flex items-center rounded-md bg-rose-600 px-3 py-1 text-[11px] font-bold uppercase tracking-widest text-white shadow-sm shadow-rose-500/40">{challenge.cards[1].badge}</span>
              </div>
              <h3 class="challenge-title mb-3 font-bold font-display text-xl text-foreground transition-colors group-hover:text-rose-700 dark:group-hover:text-rose-300 md:text-2xl">{challenge.cards[1].title}</h3>
              <p class="text-muted-foreground text-sm leading-relaxed">{challenge.cards[1].description}</p>
            </Card>
            <figure class="challenge-visual group relative min-h-[270px] overflow-hidden rounded-2xl border border-rose-200/60 bg-white shadow-sm dark:border-rose-800/30 dark:bg-rose-950/20">
              <img src="/images/challenges/risks-light.jpg" alt={challenge.cards[1].alt} loading="lazy" class="h-full min-h-[270px] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03] dark:hidden" />
              <Image src={challengeRisks} layout="none" format="webp" widths={[320, 640, 960, 1280]} sizes="(min-width: 1312px) 389px, (min-width: 1024px) calc((100vw - 144px) / 3), (min-width: 768px) calc((100vw - 128px) / 3), (min-width: 640px) calc(100vw - 80px), calc(100vw - 64px)" alt={challenge.cards[1].alt} loading="lazy" class="hidden h-full min-h-[270px] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03] dark:block" />
            </figure>
          </div>

          <!-- SILOS pair: challenge box, then corresponding image below -->
          <div class="flex flex-col gap-5 md:gap-6">
            <Card className="group relative min-h-[270px] overflow-hidden border-fuchsia-200/60 bg-white p-7 transition-transform duration-300 hover:-translate-y-1 dark:border-fuchsia-800/30 dark:bg-fuchsia-950/20 motion-reduce:transform-none motion-reduce:transition-none">
              <div class="absolute inset-x-0 top-0 h-1 rounded-t-2xl bg-gradient-to-r from-fuchsia-600 to-fuchsia-400"></div>
              <div class="mb-5 flex items-center gap-3">
                <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-fuchsia-100 text-fuchsia-600 dark:bg-fuchsia-900/40 dark:text-fuchsia-400">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14c0 1.66 4.03 3 9 3s9-1.34 9-3V5"/><path d="M3 12c0 1.66 4.03 3 9 3s9-1.34 9-3"/></svg>
                </div>
                <span class="challenge-badge inline-flex items-center rounded-md bg-fuchsia-600 px-3 py-1 text-[11px] font-bold uppercase tracking-widest text-white shadow-sm shadow-fuchsia-500/40">{challenge.cards[2].badge}</span>
              </div>
              <h3 class="challenge-title mb-3 font-bold font-display text-xl text-foreground transition-colors group-hover:text-fuchsia-700 dark:group-hover:text-fuchsia-300 md:text-2xl">{challenge.cards[2].title}</h3>
              <p class="text-muted-foreground text-sm leading-relaxed">{challenge.cards[2].description}</p>
            </Card>
            <figure class="challenge-visual group relative min-h-[270px] overflow-hidden rounded-2xl border border-fuchsia-200/60 bg-white shadow-sm dark:border-fuchsia-800/30 dark:bg-fuchsia-950/20">
              <img src="/images/challenges/silos-light.jpg" alt={challenge.cards[2].alt} loading="lazy" class="h-full min-h-[270px] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03] dark:hidden" />
              <Image src={challengeSilos} layout="none" format="webp" widths={[320, 640, 960, 1280]} sizes="(min-width: 1312px) 389px, (min-width: 1024px) calc((100vw - 144px) / 3), (min-width: 768px) calc((100vw - 128px) / 3), (min-width: 640px) calc(100vw - 80px), calc(100vw - 64px)" alt={challenge.cards[2].alt} loading="lazy" class="hidden h-full min-h-[270px] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03] dark:block" />
            </figure>
          </div>
        </div>

        <div class="mt-14 text-center">
          <p class="mx-auto max-w-xl font-bold font-display text-xl tracking-tight md:text-2xl">
            {challenge.closingPrefix}{" "}
            <br class="hidden sm:block" />
            <AnimatedGradientText client:idle speed="3s" colorFrom="#7c3aed" colorTo="#ea580c" className="font-bold font-display text-2xl md:text-3xl">
              {challenge.closingAccent}
            </AnimatedGradientText>
          </p>
        </div>
      </div>
    </div>
  </section>
  ) : (
  <div id="what-a-tedi-does" aria-hidden="true"></div>
  )}

  <!-- ═══════════════════════════════════════════
       SECTION 3 — PROVEN RESULTS (Use Cases) — Dark section
       ═══════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-muted/40 pt-12 pb-24 md:pt-16 md:pb-32 dark:bg-[#0c0a09]" id="use-cases">
    <div class="pointer-events-none absolute inset-0 opacity-[0.02] dark:opacity-[0.03]" style="background-image: linear-gradient(rgba(251,191,36,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(251,191,36,0.5) 1px, transparent 1px); background-size: 60px 60px;"></div>
    <div class="pointer-events-none absolute top-0 right-1/4 h-[400px] w-[400px] -translate-y-1/2 rounded-full bg-amber-500/5 blur-[120px] dark:bg-amber-500/8"></div>

    <div class="landing-section-frame relative z-10 mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mx-auto">
        <div class="mb-16 text-center">
          <p class="mb-4 font-medium text-orange-500 text-sm uppercase tracking-[0.2em] dark:text-orange-400">{t.useCases.eyebrow}</p>
          <h2 class="mb-4 font-bold font-display text-4xl leading-tight tracking-tight md:text-5xl lg:text-6xl">
            {t.useCases.titlePrefix}{" "}
            <span class="bg-gradient-to-r from-orange-500 to-fuchsia-500 bg-clip-text text-transparent">{t.useCases.titleAccent}</span>
          </h2>
          <p class="mx-auto max-w-2xl text-muted-foreground text-lg leading-relaxed dark:text-white/50">
            {t.useCases.description}
          </p>
        </div>

        <!-- ── USE CASE 1: Agentic Commerce (Klarna) ── -->
        <div class="mb-20 scroll-mt-28" id="use-case-klarna">
          <div class="grid items-start gap-10 lg:grid-cols-2">
            <!-- Left: Interactive ChatGPT Demo with real ComparisonLayout widget -->
            {isEuroLabsResearch ? (
              <div class="eurolabs-research-visual">
                <div class="eurolabs-console-header">
                  <span class="dot rose"></span><span class="dot amber"></span><span class="dot green"></span>
                  <span class="console-url">os.tedix.dev / tedi-cto</span>
                </div>
                <div class="eurolabs-cto-card">
                  <div class="cto-profile">
                    <img src="/images/eurolabs/aaron-twin.png" alt="Digital twin profile for the Tedi CTO" loading="lazy" />
                    <div>
                      <strong>Tedi CTO</strong>
                      <span>Runtime running · company brain active</span>
                    </div>
                  </div>
                  <div class="cto-status">
                    <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>Knowledge</span>
                    <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.5 2A2.5 2.5 0 0 0 7 4.5v15A2.5 2.5 0 0 0 9.5 22"/><path d="M14.5 2A2.5 2.5 0 0 1 17 4.5v15a2.5 2.5 0 0 1-2.5 2.5"/><path d="M7 8h10"/><path d="M7 16h10"/></svg>Brain</span>
