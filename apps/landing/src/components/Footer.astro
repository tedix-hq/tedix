---
import { defaultLocale, getLocaleContent, localizeHomePath, type Locale } from "../i18n/content";

interface Props {
	locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const content = getLocaleContent(locale).footer;
const siteName = "Tedix";
const repositoryUrl = "https://github.com/tedix-hq/tedix";
const socialLinks: Record<string, string> = { github: repositoryUrl };
const legalName = "Tedix GbR";

// Social link SVG icon class
const iconClass = "text-muted-foreground transition-colors hover:text-foreground";
const svgClass = "h-5 w-5";
---

<footer class="mt-auto border-border border-t bg-muted/30">
	<div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
		<div class="grid grid-cols-1 gap-8 md:grid-cols-4">
			<div class="space-y-4">
				<div class="flex items-center gap-2">
					<img src="/images/tedi-astronaut-waving.png" alt="Tedix" class="h-8 w-8 object-contain" />
					<h3 class="font-bold font-display text-lg">{siteName}</h3>
				</div>
				<p class="text-muted-foreground text-sm">{content.tagline}</p>
				<div class="flex space-x-4">
					{socialLinks.github && (
						<a href={socialLinks.github} target="_blank" rel="noopener noreferrer" class={iconClass} aria-label="GitHub">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={svgClass}>
								<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
								<path d="M9 18c-4.51 2-5-2-7-2"/>
							</svg>
						</a>
					)}
					{socialLinks.twitter && (
						<a href={socialLinks.twitter} target="_blank" rel="noopener noreferrer" class={iconClass} aria-label="Twitter">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={svgClass}>
								<path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/>
							</svg>
						</a>
					)}
					{socialLinks.linkedin && (
						<a href={socialLinks.linkedin} target="_blank" rel="noopener noreferrer" class={iconClass} aria-label="LinkedIn">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={svgClass}>
								<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
								<rect width="4" height="12" x="2" y="9"/>
								<circle cx="4" cy="4" r="2"/>
							</svg>
						</a>
					)}
					{socialLinks.email && (
						<a href={`mailto:${socialLinks.email}`} class={iconClass} aria-label="Email">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={svgClass}>
								<rect width="20" height="16" x="2" y="4" rx="2"/>
								<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
							</svg>
						</a>
					)}
				</div>
			</div>

			<div>
				<h4 class="mb-4 font-semibold">{content.product}</h4>
				<ul class="space-y-2 text-muted-foreground text-sm">
					<li><a href="/apps/" class="transition-colors hover:text-foreground">{content.appStore}</a></li>
					<li><a href={localizeHomePath(locale, "how-it-works")} class="transition-colors hover:text-foreground">{content.howItWorks}</a></li>
					<li><a href={localizeHomePath(locale, "why-tedix")} class="transition-colors hover:text-foreground">{content.whyTedix}</a></li>
				</ul>
			</div>

			<div>
				<h4 class="mb-4 font-semibold">{content.company}</h4>
				<ul class="space-y-2 text-muted-foreground text-sm">
					<li><a href="https://blog.tedix.dev/posts/" class="transition-colors hover:text-foreground">{content.blog}</a></li>
					<li><a href="/contact" class="transition-colors hover:text-foreground">{content.contact}</a></li>
					<li><a href={repositoryUrl} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-foreground">{content.source}</a></li>
				</ul>
			</div>

			<div>
				<h4 class="mb-4 font-semibold">{content.legal}</h4>
				<ul class="space-y-2 text-muted-foreground text-sm">
					<li><a href="/imprint" class="transition-colors hover:text-foreground">{content.imprint}</a></li>
					<li><a href="/terms" class="transition-colors hover:text-foreground">{content.terms}</a></li>
					<li><a href="/privacy" class="transition-colors hover:text-foreground">{content.privacy}</a></li>
					<li><a href="/cookies" class="transition-colors hover:text-foreground">{content.cookies}</a></li>
					<li>
						<button type="button" class="text-left transition-colors hover:text-foreground" data-consent-settings>
							{content.cookieSettings}
						</button>
					</li>
				</ul>
			</div>
		</div>

		<div class="mt-12 flex flex-col items-center justify-between border-border border-t pt-8 text-muted-foreground text-sm md:flex-row">
			<p>&copy; {new Date().getFullYear()} {legalName}. {content.rights}</p>
			<p><a href={`${repositoryUrl}/blob/main/LICENSE`} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-foreground">{content.license}</a></p>
		</div>
	</div>
</footer>
