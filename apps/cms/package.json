{
	"name": "@tedix/cms",
	"version": "0.1.0",
	"private": true,
	"description": "Site Builder Worker and MCP server for the Tedix CMS (Emdash): lets a tedi or a person edit and publish tenant websites.",
	"license": "AGPL-3.0-only",
	"type": "module",
	"scripts": {
		"clean": "rm -rf .cloudflare .wrangler dist",
		"clear-port": "../../scripts/clear-port.sh --app cms",
		"types": "cf workers types --mode production",
		"snapshot:template": "bun run scripts/generate-template-snapshot.ts",
		"snapshot:check": "bun run scripts/generate-template-snapshot.ts --check",
		"template:marketing:install": "bun install --frozen-lockfile --cwd templates/marketing",
		"templates:install": "bun run scripts/build-templates.ts --install-only",
		"dev": "bun run clear-port && bun run snapshot:template && bun ../../scripts/dev-local.ts -- vp dev",
		"build": "vp build",
		"deploy:production": "bun run snapshot:check && bun run types && vp build --mode production && cf deploy --mode production --prebuilt --message ${GIT_SHA:-${GITHUB_SHA:-unknown}}",
		"test": "bun run test:run",
		"test:run": "bun run templates:install && vp test run",
		"test:ci": "bun run test:run",
		"test:watch": "vp test",
		"type-check": "bun run snapshot:check && bun run templates:install && bun run types && tsc --noEmit"
	},
	"dependencies": {
		"@cloudflare/sandbox": "catalog:",
		"@modelcontextprotocol/client": "catalog:",
		"@tedix/api-client": "workspace:*",
		"@tedix/api-contract": "workspace:*",
		"@tedix/auth": "workspace:*",
		"@tedix/container-runtime": "workspace:*",
		"@tedix/db": "workspace:*",
		"@tedix/mcp-shared": "workspace:*",
		"@tedix/provisioning": "workspace:*",
		"@tedix/ssrf-guard": "workspace:*",
		"@tedix/tenant-directory": "workspace:*",
		"@tedix/worker-kit": "workspace:*",
		"@tedix/workers-ai": "workspace:*",
		"hono": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "catalog:",
		"@emdash-cms/plugin-types": "0.5.0",
		"@orpc/client": "catalog:",
		"@tedix/tsconfig": "workspace:*",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"cf": "catalog:",
		"emdash": "catalog:",
		"jsonc-parser": "3.3.1",
		"react": "catalog:",
		"react-dom": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	}
}
