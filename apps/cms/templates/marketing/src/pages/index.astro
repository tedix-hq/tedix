---
/** Marketing homepage backed by the native `pages/home` block composition. */
import { getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { env as workerEnv } from "cloudflare:workers";
import type { PageContentBlock } from "../../emdash-env.d.ts";
import MarketingBlocks from "../components/MarketingBlocks.astro";
import BaseMarketing from "../layouts/BaseMarketing.astro";

const settings = await getSiteSettings();
const envDefaultLocale = (workerEnv as Record<string, string | undefined>)
	.DEFAULT_LOCALE;
const originalPath = Astro.originPathname ?? Astro.url.pathname;
const publicPathPrefix = ((workerEnv as Record<string, string | undefined>).PUBLIC_PATH_PREFIX ?? "")
	.trim().replace(/\/{2,}/g, "/").replace(/\/+$/, "");
const localePath = publicPathPrefix && originalPath.startsWith(`${publicPathPrefix}/`)
	? originalPath.slice(publicPathPrefix.length)
	: originalPath;
const pathLocale = /^\/(en|de|es|fr|it|pt|nl)(?:\/|$)/.exec(
	localePath,
)?.[1];
const locale = pathLocale ?? Astro.currentLocale ?? envDefaultLocale ?? "en";
const { entry: home, cacheHint } = await getEmDashEntry("pages", "home", {
	locale,
});
if (!home) return Astro.redirect("/404");
if (cacheHint) {
	try {
		Astro.cache.set(cacheHint);
	} catch {}
}

const data = home.data;
const blocks: PageContentBlock[] = Array.isArray(data.content)
	? data.content
	: [];
if (blocks.length === 0) return Astro.redirect("/404");

const siteTitle = settings?.title ?? "Marketing";
const seo = getSeoMeta(home, {
	siteUrl: Astro.url.origin,
	path: originalPath,
	defaultTitle: typeof data.title === "string" ? data.title : siteTitle,
	defaultDescription:
		typeof data.meta_description === "string"
			? data.meta_description
			: settings?.tagline ?? undefined,
});
---

<BaseMarketing
	title={seo.title}
	description={seo.description}
	image={seo.ogImage}
	content={{ collection: "pages", id: home.data.id, slug: "home" }}
	heroBleed={true}
>
	<div {...home.edit} style="display: contents">
		<div {...home.edit.content} style="display: contents">
			<MarketingBlocks value={blocks} />
		</div>
	</div>
</BaseMarketing>
