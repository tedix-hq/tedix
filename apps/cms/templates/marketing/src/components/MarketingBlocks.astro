---
import { Blocks, defineBlockComponents } from "emdash/ui";
import type { PageContentBlock } from "../../emdash-env.d.ts";
import Prose from "./blocks/Prose.astro";
import Hero from "./blocks/Hero.astro";
import Features from "./blocks/Features.astro";
import Stats from "./blocks/Stats.astro";
import CTABand from "./blocks/CTABand.astro";
import LogoStrip from "./blocks/LogoStrip.astro";
import TextWithImage from "./blocks/TextWithImage.astro";
import Testimonials from "./blocks/Testimonials.astro";
import Pricing from "./blocks/Pricing.astro";
import FAQ from "./blocks/FAQ.astro";

interface Props {
	value?: PageContentBlock[] | null;
}

const { value } = Astro.props;
const components = defineBlockComponents<PageContentBlock>({
	marketing_prose: Prose,
	marketing_hero: Hero,
	marketing_features: Features,
	marketing_stats: Stats,
	marketing_cta: CTABand,
	marketing_logo_strip: LogoStrip,
	marketing_text_with_image: TextWithImage,
	marketing_testimonials: Testimonials,
	marketing_pricing: Pricing,
	marketing_faq: FAQ,
});
---

<Blocks {value} {components} />
