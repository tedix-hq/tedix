---
/**
 * FaqSection — visible FAQ block rendered under the article body.
 *
 * Pairs with the FAQPage JSON-LD emitted in [slug].astro. Reads the post's
 * `faq` field (free-form `json` field on the posts collection), shaped as
 * `Array<{ question: string; answer: string }>`. Empty/missing array =>
 * no render.
 *
 * Field registration: `faq` is a `json` field added to the posts collection
 * via the Emdash admin UI (Schema -> posts -> Add field -> type: json,
 * slug: faq). Once added, post editors get a JSON textarea; an array of
 * { question, answer } objects unlocks both this visible block and the
 * FAQPage rich result.
 */
import { env as workerEnv } from "cloudflare:workers";
import { getSiteSettings } from "emdash";
import { t } from "../i18n/strings";

export interface FaqItem {
	question: string;
	answer: string;
}

interface Props {
	items: FaqItem[];
}

const { items } = Astro.props;
const visible = (items ?? []).filter(
	(it): it is FaqItem =>
		!!it &&
		typeof it.question === "string" && it.question.trim().length > 0 &&
		typeof it.answer === "string" && it.answer.trim().length > 0,
);

const settings = await getSiteSettings();
const settingsLanguage = (settings as Record<string, unknown> | undefined)?.language;
const envDefaultLocale = (workerEnv as Record<string, string | undefined>).DEFAULT_LOCALE;
const locale =
	Astro.currentLocale ??
	(typeof settingsLanguage === "string" && settingsLanguage.length > 0 ? settingsLanguage : undefined) ??
	envDefaultLocale ??
	"en";
---

{visible.length > 0 && (
	<section class="mt-16 pt-12 border-t border-gray-200 dark:border-gray-800" aria-labelledby="faq-heading">
		<h2 id="faq-heading" class="font-display text-2xl md:text-3xl font-semibold mb-8">{t("faqHeading", locale)}</h2>
		<div class="space-y-4">
			{visible.map((item) => (
				<details class="group rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 px-5 py-4 open:shadow-sm transition-shadow">
					<summary class="flex items-center justify-between cursor-pointer list-none font-medium text-gray-900 dark:text-gray-100">
						<span>{item.question}</span>
						<svg class="w-4 h-4 text-gray-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
						</svg>
					</summary>
					<div class="mt-3 text-gray-600 dark:text-gray-400 leading-relaxed whitespace-pre-line">
						{item.answer}
					</div>
				</details>
			))}
		</div>
	</section>
)}
