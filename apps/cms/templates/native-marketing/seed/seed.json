							"validation": {
								"pattern": "^(?:$|[a-z][a-z0-9_-]*)$"
							}
						},
						{
							"slug": "headline",
							"label": "Headline",
							"type": "string",
							"required": true
						},
						{
							"slug": "subheadline",
							"label": "Subheadline",
