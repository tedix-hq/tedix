						},
						{
							"slug": "primary_cta_label",
							"label": "Primary CTA label",
							"type": "string"
						},
						{
							"slug": "primary_cta_url",
							"label": "Primary CTA URL",
							"type": "string",
							"validation": {
								"pattern": "^(?:$|(?:https?://|mailto:|tel:|/(?!/)|#).+)$"
