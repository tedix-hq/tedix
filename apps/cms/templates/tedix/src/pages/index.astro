---
import { getEmDashCollection, getSiteSettings } from "emdash";
import { env as workerEnv } from "cloudflare:workers";
import Base from "../layouts/Base.astro";
import CroppedImage from "../components/CroppedImage.astro";
import PostCard from "../components/PostCard.astro";
import { collectionIndexHref, contentHref } from "../lib/content-url";
import { t } from "../i18n/strings";

const settings = await getSiteSettings();
const settingsLanguage = (settings as Record<string, unknown> | undefined)?.language;
const envDefaultLocale = (workerEnv as Record<string, string | undefined>).DEFAULT_LOCALE;
const originalPath = Astro.originPathname ?? Astro.url.pathname;
const publicPathPrefix = ((workerEnv as Record<string, string | undefined>).PUBLIC_PATH_PREFIX ?? "")
	.trim().replace(/\/{2,}/g, "/").replace(/\/+$/, "");
const localePath = publicPathPrefix && originalPath.startsWith(`${publicPathPrefix}/`)
	? originalPath.slice(publicPathPrefix.length)
	: originalPath;
const pathLocale = /^\/(en|de|es|fr|it|pt|nl)(?:\/|$)/.exec(
	localePath,
)?.[1];
const locale =
	pathLocale ??
	Astro.currentLocale ??
	(typeof settingsLanguage === "string" && settingsLanguage.length > 0 ? settingsLanguage : undefined) ??
	envDefaultLocale ??
	"en";

const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 13,
	locale,
	status: "published",
});
if (cacheHint) { try { Astro.cache.set(cacheHint); } catch {} }

const featured = posts[0];
const secondary = posts.slice(1, 4);
const rest = posts.slice(4, 13);
const siteTitle = settings?.title ?? "Blog";
const siteTagline = settings?.tagline ?? t("allArticles", locale);

const orgDefaultLocale = envDefaultLocale ?? "en";
const localePrefix = locale === orgDefaultLocale ? "" : `/${locale}`;
const postsIndexHref = await collectionIndexHref("posts", {
	locale,
	defaultLocale: orgDefaultLocale,
});
const postLinks = new Map(
	await Promise.all(
		posts.map(async (post) => [
			post.data.id,
			await contentHref("posts", post.data.slug ?? post.id, {
				locale,
				defaultLocale: orgDefaultLocale,
			}),
		]),
	),
);

const dateLocaleTag = locale.includes("-") ? locale : `${locale}-${locale.toUpperCase()}`;
function formatDate(d: Date | null | undefined) {
	if (!d) return null;
	return d.toLocaleDateString(dateLocaleTag, { year: "numeric", month: "long", day: "numeric" });
}
function postHref(post: (typeof posts)[number]) {
	return postLinks.get(post.data.id) ?? postsIndexHref;
}
function primaryTerm(post: (typeof posts)[number], taxonomy: "category" | "tag") {
	const terms = (post.data as { terms?: Record<string, Array<{ slug: string; label: string }>> }).terms?.[taxonomy];
	return Array.isArray(terms) ? terms[0] : null;
}
---

<Base title={siteTitle} description={siteTagline}>
	{posts.length === 0 ? (
		<section class="max-w-lg mx-auto text-center py-32 px-4">
			<h2 class="font-display text-3xl font-bold">{t("noPostsYet", locale)}</h2>
		</section>
	) : (
		<>
			<section {...featured.edit} class="border-b border-gray-200 dark:border-gray-800 bg-gradient-to-b from-brand-50/70 via-transparent to-transparent dark:from-brand-700/10">
				<div class="max-w-6xl mx-auto px-4 lg:px-6 py-14 md:py-20">
					<div class="grid lg:grid-cols-12 gap-12 items-center">
						<div class="lg:col-span-7 space-y-6">
							{featured.data.publishedAt && (
								<div class="flex items-center gap-3 text-xs font-medium uppercase tracking-widest text-brand-600 dark:text-blue-400">
									<span class="px-2 py-1 bg-brand-50 dark:bg-blue-950/40 rounded">{t("featured", locale)}</span>
									<time>{formatDate(featured.data.publishedAt)}</time>
									{primaryTerm(featured, "category") && (
										<a href={`${localePrefix}/category/${primaryTerm(featured, "category")!.slug}/`} class="hidden sm:inline hover:underline">
											{primaryTerm(featured, "category")!.label}
										</a>
									)}
								</div>
							)}
							<a href={postHref(featured)} class="group block">
								<h1 {...featured.edit.title} class="font-display text-4xl md:text-5xl lg:text-6xl font-bold leading-[1.08] group-hover:text-brand-600 transition-colors">
									{featured.data.title}
								</h1>
								{featured.data.excerpt && (
									<p {...featured.edit.excerpt} class="text-lg md:text-xl text-gray-600 dark:text-gray-400 mt-4 leading-relaxed line-clamp-3">
										{featured.data.excerpt}
									</p>
								)}
								<div class="inline-flex items-center gap-2 mt-6 text-sm font-medium text-brand-600">
									{t("readMore", locale)}
									<svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
								</div>
							</a>
						</div>
						<div class="lg:col-span-5">
							{featured.data.featured_image ? (
								<a href={postHref(featured)} class="block overflow-hidden rounded-2xl">
									<div {...featured.edit.featured_image} class="aspect-[4/3]">
										<CroppedImage image={featured.data.featured_image} priority />
									</div>
								</a>
							) : (
								<div class="aspect-[4/3] rounded-2xl bg-gradient-to-br from-brand-500/10 via-[#2a6dfb]/10 to-transparent border border-brand-500/20 flex items-center justify-center">
									<span class="font-display text-7xl text-brand-500/30">{siteTitle.charAt(0)}</span>
								</div>
							)}
						</div>
					</div>
				</div>
			</section>

			{secondary.length > 0 && (
				<section class="border-b border-gray-200 dark:border-gray-800">
					<div class="max-w-6xl mx-auto px-4 lg:px-6 py-16">
						<h2 class="font-display text-2xl font-semibold mb-8">{t("recent", locale)}</h2>
						<div class="grid md:grid-cols-3 gap-10">
							{secondary.map((post) => (
								<PostCard
									edit={post.edit}
									title={post.data.title ?? "Untitled"}
									excerpt={post.data.excerpt}
									featuredImage={post.data.featured_image}
									href={postHref(post)}
									date={post.data.publishedAt ?? undefined}
									category={primaryTerm(post, "category")}
									readingTime={post.data.reading_time}
								/>
							))}
						</div>
					</div>
				</section>
			)}

			{rest.length > 0 && (
				<section>
					<div class="max-w-6xl mx-auto px-4 lg:px-6 py-16">
						<div class="flex items-baseline justify-between mb-8">
							<h2 class="font-display text-2xl font-semibold">{t("moreArticles", locale)}</h2>
							<a href={postsIndexHref} class="text-sm font-medium text-brand-600 hover:text-brand-700">{t("viewAll", locale)} →</a>
						</div>
						<div class="divide-y divide-gray-200 dark:divide-gray-800">
							{rest.map((post) => (
								<a {...post.edit} href={postHref(post)} class="group flex flex-col md:flex-row gap-4 md:gap-8 py-6 md:items-center">
									<div class="flex-1 min-w-0">
										<div class="flex items-center gap-3 text-xs text-gray-500 mb-2">
											{primaryTerm(post, "category") && <span class="font-medium text-brand-600">{primaryTerm(post, "category")!.label}</span>}
											{post.data.publishedAt && <time>{formatDate(post.data.publishedAt)}</time>}
											{post.data.reading_time && (<><span class="w-1 h-1 rounded-full bg-gray-400" /><span>{post.data.reading_time} {t("minRead", locale)}</span></>)}
										</div>
										<h3 {...post.edit.title} class="font-display text-xl md:text-2xl font-semibold leading-snug group-hover:text-brand-600 transition-colors">
											{post.data.title}
										</h3>
										{post.data.excerpt && (
											<p {...post.edit.excerpt} class="text-gray-600 dark:text-gray-400 mt-2 line-clamp-2">{post.data.excerpt}</p>
										)}
									</div>
									{post.data.featured_image && (
										<div {...post.edit.featured_image} class="md:w-48 md:flex-shrink-0 overflow-hidden rounded-lg aspect-[16/10] md:aspect-[4/3]">
											<CroppedImage image={post.data.featured_image} class="transition-transform duration-500 group-hover:scale-105" />
										</div>
									)}
								</a>
							))}
						</div>
					</div>
				</section>
			)}
		</>
	)}
</Base>
