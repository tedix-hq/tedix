---
/**
 * AuthorByline — renders an Emdash byline (compact or full).
 *
 * Reads native Emdash byline data, including 0.17 customFields.
 *
 * Variants:
 *   - compact (default): inline avatar circle + name + (optional) jobTitle.
 *     Use in post headers next to date/reading time.
 *   - full: avatar + name + bio paragraph + website link. Use at end of
 *     articles or on /authors/[slug] pages.
 *
 * Preferred custom-field slugs: job_title, linkedin_url, same_as.
 *
 * @example
 *   <AuthorByline byline={post.data.bylines[0].byline} />
 *   <AuthorByline byline={author} variant="full" />
 */

interface Byline {
	displayName: string;
	avatarMediaId?: string | null;
	avatarStorageKey?: string | null;
	avatarAlt?: string | null;
	bio?: string | null;
	websiteUrl?: string | null;
	jobTitle?: string | null;
	customFields?: Record<string, unknown> | null;
}

interface Props {
	byline: Byline;
	variant?: "compact" | "full";
}

const { byline, variant = "compact" } = Astro.props;
const stringValue = (value: unknown) =>
	typeof value === "string" && value.trim().length > 0 ? value.trim() : null;
const custom = byline.customFields ?? {};
const jobTitle = byline.jobTitle ?? stringValue(custom.job_title) ?? stringValue(custom.jobTitle);
const profileUrl =
	byline.websiteUrl ??
	stringValue(custom.linkedin_url) ??
	stringValue(custom.linkedin) ??
	stringValue(custom.profile_url);
const avatarUrl = byline.avatarStorageKey
	? `/_emdash/api/media/file/${byline.avatarStorageKey}`
	: byline.avatarMediaId
	? `/_emdash/api/media/file/${byline.avatarMediaId}`
	: null;
const avatarAlt = byline.avatarAlt ?? byline.displayName;
const profileLinkLabel = profileUrl?.includes("linkedin.com") ? "LinkedIn" : "Website";
---

{variant === "compact" ? (
	<div class="flex items-center gap-2">
		{avatarUrl && (
			<img
				src={avatarUrl}
				alt={avatarAlt}
				class="w-9 h-9 rounded-full object-cover ring-2 ring-white dark:ring-gray-900"
				loading="lazy"
			/>
		)}
		<div class="flex flex-col">
			<span class="text-sm font-medium text-gray-900 dark:text-gray-100 leading-tight">{byline.displayName}</span>
			{jobTitle && (
				<span class="text-xs text-gray-500 dark:text-gray-400 leading-tight">{jobTitle}</span>
			)}
		</div>
	</div>
) : (
	<aside class="mt-12 pt-8 border-t border-gray-200 dark:border-gray-800 flex gap-5 items-start" itemscope itemtype="https://schema.org/Person">
		{avatarUrl && (
			<img
				src={avatarUrl}
				alt={avatarAlt}
				class="w-16 h-16 rounded-full object-cover ring-2 ring-white dark:ring-gray-900 flex-shrink-0"
				itemprop="image"
				loading="lazy"
			/>
		)}
		<div class="flex-1 min-w-0">
			<div class="flex flex-wrap items-baseline gap-x-3">
				<h3 class="font-display text-lg font-semibold text-gray-900 dark:text-gray-50" itemprop="name">{byline.displayName}</h3>
				{jobTitle && (
					<span class="text-sm text-gray-500 dark:text-gray-400" itemprop="jobTitle">{jobTitle}</span>
				)}
			</div>
			{byline.bio && (
				<p class="mt-2 text-sm text-gray-600 dark:text-gray-400 leading-relaxed" itemprop="description">{byline.bio}</p>
			)}
			{profileUrl && (
				<a
					href={profileUrl}
					rel="noopener author"
					class="inline-flex items-center gap-1 mt-3 text-sm font-medium text-brand-600 hover:text-brand-700 dark:text-blue-400 dark:hover:text-blue-300"
					itemprop="url"
				>
					{profileLinkLabel}
					<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
					</svg>
				</a>
			)}
		</div>
	</aside>
)}
