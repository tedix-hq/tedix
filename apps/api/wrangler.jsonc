			"triggers": {
				"crons": [
					"*/2 * * * *",
					"*/15 * * * *",
					"0 * * * *",
					"0 2 * * *",
					"0 3 * * *",
					"0 4 * * *",
					"0 6 * * *",
					"0 7 * * *",
					"0 */6 * * *",
				],
			},
			"queues": {
				"producers": [
					{
						"binding": "AUTOMATION_EVENTS",
						"queue": "public-installation-queue-env-production-0",
					},
				],
				"consumers": [
