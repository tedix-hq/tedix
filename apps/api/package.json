{
	"name": "@tedix/api",
	"version": "0.1.1",
	"private": true,
	"description": "Cloudflare Worker for the tenant control plane: oRPC/OpenAPI API, Home conversations, D1 access, jobs, and admin endpoints.",
	"license": "AGPL-3.0-only",
	"type": "module",
	"exports": {
		"./rpc": "./src/rpc/routers/index.ts"
	},
	"scripts": {
		"clean": "rm -rf .wrangler",
		"clear-port": "../../scripts/clear-port.sh --app api",
		"types": "bun ../../scripts/generate-worker-types.ts api",
		"types:check": "bun ../../scripts/generate-worker-types.ts --check api",
		"dev": "bun run clear-port && bun ../../scripts/dev-local.ts -- wrangler dev",
		"dev:local-demo": "bun run clear-port && bun ../../scripts/dev-local.ts -- wrangler dev",
		"dev:local-launcher": "TEDIX_LOCAL_API_URL=http://localhost:8790 bun ../../scripts/dev-local.ts -- wrangler dev --name public-installation-api --port 8790",
		"dev:local-hmr": "TEDIX_LOCAL_API_URL=http://localhost:8790 bun ../../scripts/dev-local.ts -- wrangler dev --name public-installation-api --port 8790",
		"deploy:production": "bun run types && wrangler deploy --env production --var GIT_SHA:${GIT_SHA:-${GITHUB_SHA:-unknown}} --message ${GIT_SHA:-${GITHUB_SHA:-unknown}}",
		"tail": "wrangler tail",
		"test": "bun run test:run",
		"test:run": "bun run test:unit",
		"test:unit": "bun scripts/test-unit.ts",
		"test:watch": "vp test",
		"test:ci": "bun run test:run",
		"type-check": "tsc --noEmit",
		"test:kernel": "vp test run eval/kernel/*.test.ts src/rpc/routers/kernel/route-planner.test.ts",
		"eval:kernel:models": "bun run eval/kernel/route-eval-sweep.ts",
		"eval:kernel:trajectories": "bun run eval/kernel/trajectory-eval.ts",
		"billing:reconcile": "bun scripts/billing/reconcile-stripe.ts",
		"billing:certify-meter": "bun scripts/billing/certify-stripe-meter.ts"
	},
	"dependencies": {
		"@ai-sdk/azure": "catalog:",
		"@block65/webcrypto-web-push": "2",
		"@cloudflare/ai-chat": "catalog:",
		"@cloudflare/puppeteer": "catalog:",
		"@cloudflare/voice": "catalog:",
		"@json-render/core": "catalog:",
		"@modelcontextprotocol/client": "catalog:",
		"@orpc/client": "catalog:",
		"@orpc/openapi": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/zod": "catalog:",
		"@tedix/api-client": "workspace:*",
		"@tedix/api-contract": "workspace:*",
		"@tedix/auth": "workspace:*",
		"@tedix/chat-transport": "workspace:*",
		"@tedix/context-core": "workspace:*",
		"@tedix/db": "workspace:*",
		"@tedix/mcp-client-core": "workspace:*",
		"@tedix/mcp-shared": "workspace:*",
		"@tedix/provisioning": "workspace:*",
		"@tedix/ssrf-guard": "workspace:*",
		"@tedix/tedi-session": "workspace:*",
		"@tedix/tenant-directory": "workspace:*",
		"@tedix/voice": "workspace:*",
		"@tedix/widget-i18n": "workspace:*",
		"@tedix/worker-kit": "workspace:*",
		"@tedix/workers-ai": "workspace:*",
		"@types/node": "catalog:",
		"acorn": "8.18.0",
		"agents": "catalog:",
		"ai": "catalog:",
		"hono": "catalog:",
		"stripe": "^23.0.1",
		"yaml": "^2.9.1",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@tedix/tsconfig": "workspace:*",
		"drizzle-orm": "catalog:",
		"esbuild": "0.28.2",
		"fast-xml-parser": "catalog:",
		"fflate": "catalog:",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	},
	"tedixCi": {
		"splitTestScripts": true,
		"testScriptShards": {
			"test:unit": 4
		}
	}
}
