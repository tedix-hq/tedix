{
	"name": "@tedix/os",
	"version": "0.1.0",
	"private": true,
	"description": "Tedix OS, the product web application: conversations, workers, apps, skills, work management, and administration.",
	"license": "AGPL-3.0-only",
	"type": "module",
	"scripts": {
		"clean": "rm -rf .cloudflare dist node_modules/.cache",
		"clear-port": "../../scripts/clear-port.sh --app os",
		"dev": "bun run clear-port && bun run dev:fixtures",
		"dev:fixtures": "vp dev --port 3010 --strictPort",
		"dev:local-demo": "bun run clear-port && bun run dev:fixtures",
		"dev:local-launcher": "TEDIX_OS_LOCAL_DEV=1 bun ../../scripts/dev-local.ts -- vp preview --port 3030 --strictPort",
		"dev:local-hmr": "TEDIX_LOCAL_COMPATIBILITY_DATE=2026-08-11 bun ../../scripts/dev-local.ts -- vp dev --port 3030 --strictPort",
		"build": "vp build",
		"build:local": "TEDIX_LOCAL_COMPATIBILITY_DATE=2026-08-11 TEDIX_OS_LOCAL_DEV=1 bun ../../scripts/dev-local.ts -- vp build --mode development",
		"preview": "vp preview --port 3010",
		"deploy:production": "vp build --mode production && cf deploy --mode production --prebuilt --message ${GIT_SHA:-${GITHUB_SHA:-unknown}}",
		"lint": "vp lint .",
		"test": "bun run test:run",
		"test:run": "vp test run && bun run test:workerd",
		"test:workerd": "vp test run --config vitest.workers.config.ts",
		"test:browser:apps": "bun browser-tests/widget-apps.spec.ts",
		"test:ci": "bun run test:run && bun run test:browser:apps",
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"@cloudflare/kumo": "2.14.0",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/language": "^6.12.4",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.13",
		"@descope/react-sdk": "^3.3.12",
		"@fontsource-variable/comfortaa": "^5.3.0",
		"@lezer/highlight": "^1.2.5",
		"@modelcontextprotocol/client": "catalog:",
		"@modelcontextprotocol/ext-apps": "catalog:",
		"@orpc/tanstack-query": "catalog:",
		"@phosphor-icons/react": "2.1.10",
		"@tanstack/react-form": "^1.33.5",
		"@tanstack/react-query": "^5.104.1",
		"@tanstack/react-router": "1.170.41",
		"@tedix/api-client": "workspace:*",
		"@tedix/api-contract": "workspace:*",
		"@tedix/auth": "workspace:*",
		"@tedix/chat-transport": "workspace:*",
		"@tedix/design-tokens": "workspace:*",
		"@tedix/mcp-shared": "workspace:*",
		"@tedix/tenant-directory": "workspace:*",
		"@tedix/webmcp-core": "workspace:*",
		"@tedix/widget-i18n": "workspace:*",
		"@tedix/worker-kit": "workspace:*",
		"@tiptap/core": "^3.31.4",
		"@tiptap/extension-color": "^3.31.4",
		"@tiptap/extension-highlight": "^3.31.4",
		"@tiptap/extension-image": "^3.31.4",
		"@tiptap/extension-text-align": "^3.31.4",
		"@tiptap/extension-text-style": "^3.31.4",
		"@tiptap/pm": "^3.31.4",
		"@tiptap/react": "^3.31.4",
		"@tiptap/starter-kit": "^3.31.4",
		"capnweb": "^0.12.0",
		"clsx": "^2.1.1",
		"echarts": "^6.1.0",
		"fast-diff": "^1.3.0",
		"hot-formula-parser": "^4.0.0",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "catalog:",
		"@cloudflare/vitest-plugin": "catalog:",
		"@tailwindcss/vite": "4.3.3",
		"@tanstack/router-plugin": "1.168.42",
		"@tedix/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "6.1.1",
		"cf": "catalog:",
		"happy-dom": "^20.14.5",
		"playwright": "^1.63.0",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	}
}
