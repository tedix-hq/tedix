{
	"name": "@tedix/mcp",
	"version": "0.1.0",
	"private": true,
	"description": "Stateless multi-tenant MCP edge that serves configuration-driven tools and widgets from shared Workers and D1.",
	"license": "AGPL-3.0-only",
	"type": "module",
	"scripts": {
		"clean": "rm -rf .cloudflare .wrangler dist",
		"clear-port": "../../scripts/clear-port.sh --app mcp",
		"types": "cf workers types --mode production",
		"dev": "bun run clear-port && bun ../../scripts/dev-local.ts -- vp dev",
		"dev:local-hmr": "bun ../../scripts/dev-local.ts -- vp dev --port 3000 --strictPort",
		"dev:local-launcher": "TEDIX_LOCAL_API_URL=http://localhost:8790 bun ../../scripts/dev-local.ts -- vp dev --port 3000 --strictPort",
		"build": "vp build",
		"deploy:production": "bun run types && vp build --mode production && cf deploy --mode production --prebuilt --message ${GIT_SHA:-${GITHUB_SHA:-unknown}}",
		"test": "bun run test:run",
		"test:run": "vp test run",
		"test:watch": "vp test",
		"test:integration": "vp test run src/codemode-payment.integration.test.ts src/payment-gate.integration.test.ts",
		"test:workerd": "vp test run --config vitest.workerd.config.ts && bun test/build-real-api.mjs",
		"test:ci": "bun run test:run",
		"type-check": "bun run types && tsc --noEmit"
	},
	"dependencies": {
		"@cloudflare/codemode": "catalog:",
		"@json-render/core": "catalog:",
		"@json-render/yaml": "^0.21.0",
		"@modelcontextprotocol/client": "catalog:",
		"@modelcontextprotocol/server": "catalog:",
		"@tedix/api-client": "workspace:*",
		"@tedix/api-contract": "workspace:*",
		"@tedix/auth": "workspace:*",
		"@tedix/db": "workspace:*",
		"@tedix/mcp-shared": "workspace:*",
		"@tedix/ssrf-guard": "workspace:*",
		"@tedix/tedi-codemode-core": "workspace:*",
		"@tedix/tenant-directory": "workspace:*",
		"@tedix/worker-kit": "workspace:*",
		"@x402/core": "catalog:",
		"@x402/evm": "catalog:",
		"drizzle-orm": "catalog:",
		"hono": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "catalog:",
		"@cloudflare/vitest-plugin": "catalog:",
		"@modelcontextprotocol/ext-apps": "catalog:",
		"@modelcontextprotocol/sdk": "1.32.0",
		"@tedix/tsconfig": "workspace:*",
		"cf": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	}
}
