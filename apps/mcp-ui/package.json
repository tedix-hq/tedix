{
	"name": "@tedix/mcp-ui",
	"version": "0.0.1",
	"private": true,
	"description": "Astro and React renderer for MCP Apps widgets and resources.",
	"license": "AGPL-3.0-only",
	"type": "module",
	"scripts": {
		"clean": "rm -rf .wrangler dist .astro node_modules/.vite",
		"clear-port": "../../scripts/clear-port.sh --app mcp-ui",
		"dev": "bun run clear-port && MCP_UI_URL=${MCP_UI_URL:-http://localhost:3001} astro dev --force --port 3001",
		"generate:catalog-prompt": "bun run scripts/generate-catalog-prompt.ts",
		"build": "MCP_UI_URL=${MCP_UI_URL:-http://localhost:3001} astro build",
		"build:production": "CLOUDFLARE_ENV=production astro build",
		"preview": "astro preview",
		"deploy:production": "bun run build:production && wrangler deploy --var GIT_SHA:${GIT_SHA:-${GITHUB_SHA:-unknown}} --message ${GIT_SHA:-${GITHUB_SHA:-unknown}}",
		"types": "bun ../../scripts/generate-worker-types.ts mcp-ui",
		"types:check": "bun ../../scripts/generate-worker-types.ts --check mcp-ui",
		"test": "bun run test:run",
		"test:run": "vp test run",
		"test:watch": "vp test",
		"test:ci": "bun run test:run",
		"type-check": "MCP_UI_INSPECTOR_PORT=0 astro sync && tsc --noEmit"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^14.3.3",
		"@astrojs/react": "^7.0.0",
		"@json-render/core": "catalog:",
		"@json-render/devtools-react": "^0.21.0",
		"@json-render/directives": "^0.21.0",
		"@json-render/react": "^0.21.0",
		"@json-render/shadcn": "catalog:",
		"@json-render/yaml": "^0.21.0",
		"@modelcontextprotocol/ext-apps": "catalog:",
		"@tedix/api-client": "workspace:*",
		"@tedix/api-contract": "workspace:*",
		"@tedix/auth": "workspace:*",
		"@tedix/widget-ui": "workspace:*",
		"astro": "^7.3.5",
		"react": "catalog:",
		"react-dom": "catalog:",
		"recharts": "^3.10.1",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@tailwindcss/vite": "4.3.3",
		"@tedix/tsconfig": "workspace:*",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"tailwindcss": "^4.3.3",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	}
}
