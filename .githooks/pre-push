#!/usr/bin/env bash
# The repository's pre-push gate: validation runs here, before the push.
#
# Installed by `bun run hooks:install` (also wired to `prepare`, so `bun install`
# sets it up). Git feeds "<localRef> <localSha> <remoteRef> <remoteSha>" lines on
# stdin, one per ref being pushed.
#
# Each executable in .githooks/pre-push.d/ runs first with "<remoteSha>
# <localSha>" for every pushed ref, then the repo gates run scoped to the
# pushed range (scripts/ci/preflight-gates.mjs). Without bun the hook does
# nothing: it must never make the repo unpushable. `git push --no-verify`
# bypasses it.
set -uo pipefail

command -v bun >/dev/null 2>&1 || exit 0

root="$(git rev-parse --show-toplevel)"
# Git exports its location to hooks (GIT_DIR, GIT_INDEX_FILE, ...). Every
# child that spawns git -- test fixtures included -- would inherit it, ignore
# its own cwd, and write into THIS repository: that is how fixture identities
# ("Fixture", "Test") reached main. Drop it once here; cwd decides from now on.
cd "$root" || exit 1
unset GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_CEILING_DIRECTORIES GIT_COMMON_DIR \
	GIT_DIR GIT_INDEX_FILE GIT_NAMESPACE GIT_OBJECT_DIRECTORY GIT_PREFIX \
	GIT_WORK_TREE

# One kernel lock per user, shared by independent clones as well as worktrees.
# Fail closed if Python is missing; no gate may run without the lock.
exec python3 "$root/scripts/dev/push-gate-lock.py" \
	"$root/.githooks/pre-push-checks" "$@"
