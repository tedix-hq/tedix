{
	"description": "Runs the installed Tedix CLI (tedix hooks). Optional Tedix session preflight, opt-in decision capture and an opt-in turn-status reporter. Enable reads with a local repository binding or TEDIX_PLUGIN_PREFLIGHT=1; recording requires setup agents context enable-decision-capture (Claude Code also waits in the background for a Tedix OS answer or a tedi auto reply; Codex packages omit that rewake hook and instead wait up to 90 seconds at Stop for an auto reply, a hook Claude packages omit); status reporting requires ~/.tedix/agent-status.json or TEDIX_AGENT_STATUS=1.",
	"hooks": {
		"SessionStart": [
			{
				"matcher": "^(startup|resume|clear|compact|fork)$",
				"hooks": [
					{
						"type": "command",
						"command": "tedix hooks session-start",
						"timeout": 15,
						"additionalContextLimit": 600,
						"statusMessage": "Checking opt-in Tedix context"
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "tedix hooks prompt-context",
						"timeout": 15,
						"additionalContextLimit": 6500,
						"statusMessage": "Reading selected Tedix decisions and Work updates"
					},
					{
						"type": "command",
						"command": "tedix hooks capture-reply",
						"timeout": 30,
						"async": true
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "tedix hooks status",
						"async": true,
						"timeout": 10
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "tedix hooks capture-stop",
						"timeout": 30,
						"async": true
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "tedix hooks await-reply",
						"timeout": 14460,
						"asyncRewake": true
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "tedix hooks await-draft",
						"timeout": 320
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "tedix hooks status",
						"async": true,
						"timeout": 10
					}
				]
			}
		],
		"StopFailure": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "tedix hooks status",
						"async": true,
						"timeout": 10
					}
				]
			}
		],
		"PermissionRequest": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "tedix hooks status",
						"async": true,
						"timeout": 10
					}
				]
			}
		],
		"Notification": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "tedix hooks status",
						"async": true,
						"timeout": 10
					}
				]
			}
		],
		"PostToolUse": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "tedix hooks status",
						"async": true,
						"timeout": 10
					}
				]
			}
		],
		"SessionEnd": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "tedix hooks status",
						"async": true,
						"timeout": 10
					}
				]
			}
		]
	}
}
