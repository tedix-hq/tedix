{
	"description": "Optional Tedix session preflight, opt-in decision capture and an opt-in turn-status reporter. Enable reads with a local repository binding or TEDIX_PLUGIN_PREFLIGHT=1; recording requires setup agents context enable-decision-capture; status reporting requires ~/.tedix/agent-status.json or TEDIX_AGENT_STATUS=1.",
	"hooks": {
		"SessionStart": [
			{
				"matcher": "^(startup|resume|clear|compact|fork)$",
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py\"",
						"timeout": 15,
						"additionalContextLimit": 600,
						"statusMessage": "Checking opt-in Tedix context"
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/user_prompt_submit.py\"",
						"timeout": 15,
						"additionalContextLimit": 6500,
						"statusMessage": "Reading selected Tedix decisions and Work updates"
					},
					{
						"type": "command",
						"command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/decision_capture.py\" reply",
						"timeout": 30,
						"async": true
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/agent_status.py\"",
						"async": true,
						"timeout": 10
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/decision_capture.py\" stop",
						"timeout": 30,
						"async": true
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/agent_status.py\"",
						"async": true,
						"timeout": 10
					}
				]
			}
		],
		"StopFailure": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/agent_status.py\"",
						"async": true,
						"timeout": 10
					}
				]
			}
		],
		"PermissionRequest": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/agent_status.py\"",
						"async": true,
						"timeout": 10
					}
				]
			}
		],
		"Notification": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/agent_status.py\"",
						"async": true,
						"timeout": 10
					}
				]
			}
		],
		"PostToolUse": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/agent_status.py\"",
						"async": true,
						"timeout": 10
					}
				]
			}
		],
		"SessionEnd": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/agent_status.py\"",
						"async": true,
						"timeout": 10
					}
				]
			}
		]
	}
}
