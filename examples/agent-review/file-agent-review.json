{
	"toolId": "file_agent_review",
	"toolTypeId": "rest",
	"title": "File agent review",
	"description": "Submit a sanitized Tedix adoption review to the public feedback intake. Returns an opaque receipt, not verified findings. No project authority or execution is granted.",
	"inputSchema": {
		"$schema": "https://json-schema.org/draft/2020-12/schema",
		"type": "object",
		"properties": {
			"reportMarkdown": {
				"type": "string",
				"minLength": 200,
				"maxLength": 24576
			},
			"feedback": {
				"type": "object",
				"properties": {
					"version": {
						"type": "number",
						"const": 1
					},
					"reviewedSha": {
						"type": "string",
						"pattern": "^[a-f0-9]{40}$"
					},
					"projectContext": {
						"type": "string",
						"minLength": 1,
						"maxLength": 2000
					},
					"fitScore": {
						"type": "integer",
						"minimum": 0,
						"maximum": 5
					},
					"blockers": {
						"maxItems": 20,
						"type": "array",
						"items": {
							"type": "string",
							"minLength": 1,
							"maxLength": 2000
						}
					},
					"suggestions": {
						"maxItems": 20,
						"type": "array",
						"items": {
							"type": "string",
							"minLength": 1,
							"maxLength": 2000
						}
					},
					"bugs": {
						"maxItems": 20,
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"title": {
									"type": "string",
									"minLength": 1,
									"maxLength": 200
								},
								"evidence": {
									"type": "string",
									"minLength": 1,
									"maxLength": 2000
								},
								"repro": {
									"type": "string",
									"minLength": 1,
									"maxLength": 2000
								},
								"expected": {
									"type": "string",
									"minLength": 1,
									"maxLength": 2000
								},
								"actual": {
									"type": "string",
									"minLength": 1,
									"maxLength": 2000
								}
							},
							"required": ["title", "evidence", "repro", "expected", "actual"],
							"additionalProperties": false
						}
					}
				},
				"required": [
					"version",
					"reviewedSha",
					"projectContext",
					"fitScore",
					"blockers",
					"suggestions",
					"bugs"
				],
				"additionalProperties": false
			},
			"website": {
				"type": "string",
				"maxLength": 0
			}
		},
		"required": ["reportMarkdown", "feedback"],
		"additionalProperties": false
	},
	"annotations": {
		"readOnlyHint": false,
		"destructiveHint": false,
		"idempotentHint": true,
		"openWorldHint": true
	},
	"writeCapability": "write",
	"config": {
		"transport": "external",
		"baseUrl": "https://api.tedix.dev",
		"endpoint": "public/agent-review",
		"method": "POST",
		"timeout": 20000,
		"approvalPolicy": "never",
		"_aggregateNamespace": "work"
	},
	"enabled": true
}
