{
	"//": "scripts/ is not a workspace, so the recursive type-check never visits it; `type-check:scripts` checks the files listed here. Add a file once it type-checks clean; much of scripts/ still does not.",
	"extends": "@tedix/tsconfig/node.json",
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"allowJs": true,
		"checkJs": false,
		"incremental": true,
		"noEmit": true,
		"types": ["node", "bun-types"]
	},
	"include": [
		"agent-bootstrap.test.ts",
		"bump.ts",
		"bump.test.ts",
		"ci/browser-evidence.test.ts",
		"ci/upload-artifact.mjs",
		"ci/upload-artifact.test.ts",
		"ci/browser-quarantine.mjs",
		"ci/browser-quarantine.test.ts",
		"ci/focus-clip-findings.test.ts",
		"ci/focus-clip-shards.test.ts",
		"ci/full-suite-hourly.mjs",
		"ci/full-suite-hourly.test.ts",
		"ci/affected-suite.test.ts",
		"ci/full-suite-workflow.test.ts",
		"ci/backfill-commit-watch.mjs",
		"ci/backfill-commit-watch.test.ts",
		"ci/notify-repository-observer.mjs",
		"ci/notify-repository-observer.test.ts",
		"ci/sanitize-html.test.ts",
		"ci/spec-outcome.test.ts",
		"ci/spec-shards.test.ts",
		"dev/**/*.ts",
		"eval/memory-bench/**/*.ts",
		"eval/decision-graph/*.mjs",
		"eval/decision-graph/*.ts",
		"skills/install-calendar-coordinator.ts",
		"skills/render-planning-board-sync.ts",
		"../apps/skill-runtime/examples/calendar-coordinator/scripts/workflow.ts",
		"dev-local.ts",
		"local-installation-seed.ts",
		"local-installation-seed.test.ts",
		"generate-worker-types.test.ts",
		"generate-worker-types.ts",
		"lint-contracts.ts",
		"descope/**/*.ts",
		"docs/check-agents-refs.ts",
		"docs/check-agents-refs.test.ts",
		"lib/remote-d1.ts",
		"lib/remote-d1.test.ts",
		"lint-remote-d1.ts",
		"lint-remote-d1.test.ts",
		"lint-loader-sandbox.ts",
		"lint-kumo.ts",
		"lint-worker-route-authz.ts",
		"lint-os.ts",
		"lint-repo.ts",
		"lint-vite-plus-imports.ts",
		"lint-session-genericity.ts",
		"lint-session-genericity.test.ts",
		"lint-demo-identities.ts",
		"lint-demo-identities.test.ts",
		"oxc-ast.ts",
		"oss/dependency-licenses.ts",
		"oss/secret-scan.ts",
		"release/postdeploy-smoke.ts",
		"secrets/rotate-master-key.ts",
		"mcp/sync-tool-schemas.ts",
		"vite/test-capacity.test.ts"
	],
	"exclude": ["node_modules"]
}
