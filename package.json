{
	"name": "tedix",
	"private": true,
	"license": "AGPL-3.0-only",
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"build": "vp run -r build",
		"cms:emdash-release:validate": "bun apps/cms/scripts/emdash-release-validate.ts",
		"cms:mcp:schema-repair": "bun apps/cms/scripts/mcp-schema-repair.ts",
		"cms:mcp:tool-repair": "bun apps/cms/scripts/mcp-tool-repair.ts",
		"cms:mcp:validate": "bun apps/cms/scripts/mcp-surface-validate.ts",
		"cms:plugin-trust:validate": "bun apps/cms/scripts/plugin-trust-validate.ts",
		"cms:responsive-media:validate": "bun apps/cms/scripts/responsive-media-validate.ts",
		"cms:scheduler:validate": "bun apps/cms/scripts/scheduler-validate.ts",
		"cms:template:marketing:build": "bun install --cwd apps/cms/templates/marketing --frozen-lockfile && bun run --cwd apps/cms/templates/marketing build",
		"cms:template:tedix:build": "bun install --cwd apps/cms/templates/tedix --frozen-lockfile && bun run --cwd apps/cms/templates/tedix build",
		"connections:seed-providers": "bun scripts/descope/seed-connection-providers.ts",
		"db:drift:check": "cd packages/db && bun run db:drift:check",
		"db:migrate": "cd packages/db && bun run db:migrate",
		"db:migrate:check": "cd packages/db && bun run db:migrate:check",
		"db:migrate:generate": "cd packages/db && bun run db:migrate:generate",
		"db:migrate:list": "cd packages/db && bun run db:migrate:list",
		"db:schema:check": "cd packages/db && bun run db:schema:check",
		"dev": "./scripts/dev-with-logs.sh",
		"dev:health": "./scripts/dev-health.sh",
		"dev:health:full": "./scripts/dev-health.sh --full",
		"dev:health:os": "./scripts/dev-health.sh --os",
		"dev:local:demo-acceptance": "bun scripts/local-demo-acceptance.ts",
		"dev:local:demo-seed": "cd apps/api && bun ../../scripts/dev-local.ts -- wrangler d1 execute DB --file ../../scripts/local-demo-seed.sql",
		"dev:local:demo-stack": "vp run --parallel --filter @tedix/api --filter @tedix/mcp --filter @tedix/os dev:local-launcher",
		"dev:local:seed": "cd packages/db && bun ../../scripts/dev-local.ts -- wrangler d1 migrations apply DB",
		"dev:local:test": "bun test scripts/dev-local.test.ts",
		"worktree:gc": "bun scripts/dev/worktree-gc.ts",
		"dev:os-stack": "./scripts/dev-with-logs.sh dev os",
		"docs:public:check": "bun scripts/docs/check-public-docs.ts",
		"format": "vp fmt",
		"format:check": "vp fmt --check",
		"hooks:install": "git config core.hooksPath .githooks",
		"installation-manifest:check": "bun run --filter @tedix/installation-manifest check",
		"installation-manifest:overlay": "bun packages/installation-manifest/src/wrangler-overlay-cli.ts --worker control-api --out apps/api/wrangler.oss-example.json --secrets-out apps/api/wrangler.oss-example.secrets.json",
		"installation-manifest:overlay:check": "bun run installation-manifest:overlay --check",
		"lint": "bun run lint:repo && bun run format:check && bun run lint:code && bun run lint:deps && bun run type-check && bun run type-check:scripts && bun run types:check",
		"lint:authz": "bun scripts/lint-authz.ts",
		"lint:code": "vp lint",
		"lint:d1": "bun scripts/lint-d1.ts",
		"lint:db-access": "bun scripts/lint-db-access.ts",
		"lint:deps": "sherif && bun scripts/ci/check-deps.mjs",
		"lint:exports": "bun scripts/check-package-exports.ts",
		"lint:fix": "vp check --fix",
		"lint:knip": "TEDIX_BUILD_LOCAL_DEMO_ENABLED=true knip",
		"lint:kumo": "bun scripts/lint-kumo.ts",
		"lint:repo": "bun scripts/lint-repo.ts",
		"mcp:sync-tool-schemas": "bun scripts/mcp/sync-tool-schemas.ts",
		"oss:check": "bun scripts/oss/public-surface.ts && bun scripts/oss/dependency-licenses.ts",
		"prepare": "bun run hooks:install",
		"release:notes": "bun scripts/release/generate-release-notes.ts",
		"run-local": "bun scripts/run-local.ts",
		"scan:secrets": "bun scripts/oss/secret-scan.ts",
		"tedix": "bun packages/cli/src/index.ts",
		"test:ci": "vp run -r --concurrency-limit 1 test:ci",
		"test:scripts": "bun test $(git ls-files --cached --others --exclude-standard ':(glob)scripts/**/*.test.*')",
		"bump:check": "bun scripts/bump.ts --check",
		"bump:interactive": "bun scripts/bump.ts --interactive",
		"bump:minor": "bun scripts/bump.ts --interactive --target minor",
		"bump:latest": "bun scripts/bump.ts",
		"bump:verify": "bun scripts/bump.ts --verify",
		"type-check": "vp run -r --concurrency-limit 4 type-check",
		"type-check:scripts": "tsc -p scripts/tsconfig.json --noEmit",
		"types:check": "bun scripts/generate-worker-types.ts --check",
		"types:generate": "bun scripts/generate-worker-types.ts",
		"verify": "bun scripts/ci/preflight-gates.mjs"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@tedix/api-client": "workspace:*",
		"@tedix/api-contract": "workspace:*",
		"@tedix/db": "workspace:*",
		"@tedix/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"bun-types": "^1.4.2",
		"cf": "catalog:",
		"jiti": "catalog:",
		"jsonc-parser": "3.3.1",
		"knip": "^6.39.0",
		"mdast-util-from-markdown": "^2.1.0",
		"oxc-parser": "^0.152.0",
		"sherif": "^1.13.0",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"wrangler": "catalog:",
		"zod": "catalog:"
	},
	"overrides": {
		"@modelcontextprotocol/sdk": "1.32.0",
		"@puppeteer/browsers": "3.2.3",
		"@tiptap/core": "3.31.4",
		"@tiptap/pm": "3.31.4",
		"@vitest/browser": "4.1.11",
		"@vitest/browser-preview": "4.1.11",
		"@vitest/mocker": "4.1.11",
		"@vitest/pretty-format": "4.1.11",
		"@vitest/snapshot": "4.1.11",
		"@vitest/spy": "4.1.11",
		"@vitest/utils": "4.1.11",
		"chat": "catalog:",
		"sharp": "0.35.5",
		"vite": "catalog:",
		"vitest": "catalog:",
		"zod": "4.6.5"
	},
	"packageManager": "bun@1.4.2",
	"catalog": {
		"chat": "4.41.1",
		"fast-xml-parser": "^5.11.2",
		"@ai-sdk/azure": "^4.0.90",
		"@cloudflare/ai-chat": "^0.12.1",
		"@cloudflare/puppeteer": "1.4.0",
		"@cloudflare/sandbox": "1.0.0",
		"@cloudflare/vite-plugin": "^1.62.5",
		"@cloudflare/vitest-plugin": "1.3.6",
		"@cloudflare/voice": "0.5.0",
		"@cloudflare/workers-types": "^5.20261005.1",
		"@json-render/core": "^0.21.0",
		"@json-render/shadcn": "^0.21.0",
		"@modelcontextprotocol/ext-apps": "^2.0.3",
		"@orpc/client": "2.0.0-beta.36",
		"@orpc/contract": "2.0.0-beta.36",
		"@orpc/openapi": "2.0.0-beta.36",
		"@orpc/server": "2.0.0-beta.36",
		"@orpc/tanstack-query": "2.0.0-beta.36",
		"@orpc/zod": "2.0.0-beta.36",
		"@types/node": "^26.6.4",
		"@x402/core": "^2.28.0",
		"@x402/evm": "^2.28.0",
		"agents": "0.26.0",
		"drizzle-orm": "1.0.0-rc.4",
		"fflate": "^0.8.3",
		"hono": "^4.13.13",
		"jiti": "^2.7.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"typescript": "^7.0.2",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.3.3",
		"vite-plus": "0.3.3",
		"vitest": "4.1.11",
		"cf": "1.0.0-beta.12",
		"@cloudflare/config": "0.23.0",
		"wrangler": "4.147.0",
		"zod": "^4.6.5",
		"@modelcontextprotocol/client": "2.3.0",
		"@modelcontextprotocol/server": "2.3.0",
		"@modelcontextprotocol/core": "2.3.0",
		"emdash": "1.1.0",
		"@emdash-cms/cloudflare": "1.1.0",
		"@cloudflare/codemode": "^0.5.3",
		"@earendil-works/pi-ai": "1.0.3",
		"@earendil-works/pi-durable": "1.0.3",
		"@cloudflare/computer": "0.4.0",
		"@cloudflare/shell": "0.4.3",
		"ai": "7.0.127",
		"@ai-sdk/provider": "^4.0.21"
	},
	"patchedDependencies": {
		"agents@0.26.0": "patches/agents@0.26.0.patch",
		"@emdash-cms/cloudflare@1.1.0": "patches/@emdash-cms/cloudflare@1.1.0.patch",
		"emdash@1.1.0": "patches/emdash@1.1.0.patch"
	},
	"trustedDependencies": [
		"esbuild",
		"workerd"
	]
}
