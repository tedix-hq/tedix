{
	"name": "@tedix/voice",
	"version": "0.1.0",
	"private": true,
	"description": "Worker-side voice: live-call runtime helpers, speech-to-text and text-to-speech.",
	"license": "AGPL-3.0-only",
	"type": "module",
	"exports": {
