{
	"version": 1,
	"optionalScopes": true,
	"allowPartialScopes": true,
	"connectionScopes": {
		"connections.read": {
			"description": "Read verified connected app data",
			"readOnly": true
		},
		"connections.execute": {
			"description": "Run connected app actions, including writes",
			"readOnly": false
		},
		"connections.admin": {
			"description": "Run destructive connected app actions",
			"readOnly": false
		}
	},
	"operatorScopes": {
		"platform:admin": {
			"description": "Administer the Tedix platform across organizations",
			"readOnly": false
		}
	},
	"protocolScopes": {
		"openid": {
			"advertise": false
		},
		"offline_access": {
			"advertise": false
		},
		"profile": {
			"advertise": true
		},
		"email": {
			"advertise": true
		}
	}
