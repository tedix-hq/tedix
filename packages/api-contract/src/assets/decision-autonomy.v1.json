{
	"version": 1,
	"reservedClassPattern": "(?:^|[.:_-])(?:money|publish|send|outbound|consent|credentials?|permissions?|roles?|delete|legal|production_auth)(?:$|[.:_-])",
	"rules": [
		{
			"effectKind": "create_owner_task",
			"classes": ["internal.work.create", "crm.followup", "crm.follow-up"],
			"actionContent": "create internal Work item",
			"requirements": []
		},
		{
			"effectKind": "governed_push",
			"classes": ["internal.code.push"],
			"actionContent": "push validated code through governed path",
			"requirements": ["validated", "governed"]
		},
		{
			"effectKind": "toggle_internal_setting",
			"classes": ["internal.setting.toggle"],
			"actionContent": "toggle agent owned internal setting",
			"requirements": ["agentOwned"]
		}
	]
}
