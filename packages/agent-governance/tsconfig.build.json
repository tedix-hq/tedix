{
	"compilerOptions": {
		"isolatedModules": true,
		"lib": ["es2022", "DOM"],
		"noUncheckedSideEffectImports": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2022",
		"types": [],
		"declaration": true,
		"outDir": "dist",
		"rootDir": "src"
	},
	"include": ["src/record.ts", "src/seal.ts", "src/evidence.ts"]
}
